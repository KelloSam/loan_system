<%# Breadcrumb + header %>
<div class="mb-6 flex flex-col sm:flex-row sm:items-start sm:justify-between gap-3">
  <div>
    <div class="flex items-center gap-2 text-sm text-gray-400 mb-1">
      <%= link "Customers", to: ~p"/admin/customers", class: "hover:text-navy-600" %>
      <span>›</span>
      <span class="text-navy-900 font-medium"><%= @customer.name %></span>
    </div>
    <h1 class="text-2xl font-bold text-navy-900"><%= @customer.name %></h1>
    <p class="text-sm text-gray-400 mt-0.5">
      Member since <%= Calendar.strftime(@customer.inserted_at, "%B %Y") %>
    </p>
  </div>
  <div class="flex gap-2 flex-wrap">
    <%= link "Edit Customer", to: ~p"/admin/customers/#{@customer}/edit", class: "btn-outline" %>
    <%= link "New Loan", to: ~p"/admin/loans/new", class: "btn-gold" %>
  </div>
</div>

<%# Stat cards %>
<div class="grid grid-cols-2 gap-4 mb-6">
  <div class="card p-5">
    <p class="text-sm text-gray-500">Total Loans</p>
    <p class="stat-value"><%= @customer.total_loans %></p>
  </div>
  <div class="card p-5">
    <p class="text-sm text-gray-500">Outstanding Balance</p>
    <p class="stat-value text-xl text-red-600">ZMW <%= @customer.current_balance %></p>
  </div>
</div>

<%# Customer details %>
<div class="card p-6 mb-6">
  <h2 class="section-title mb-4">Customer Details</h2>
  <dl class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-x-6 gap-y-4">
    <div>
      <dt class="text-xs font-medium text-gray-400 uppercase tracking-wide">Phone</dt>
      <dd class="mt-1 text-sm font-medium text-navy-900"><%= @customer.phone %></dd>
    </div>
    <div>
      <dt class="text-xs font-medium text-gray-400 uppercase tracking-wide"><%= String.capitalize(@customer.id_type) %></dt>
      <dd class="mt-1 text-sm font-medium text-navy-900"><%= @customer.id_number %></dd>
    </div>
    <div>
      <dt class="text-xs font-medium text-gray-400 uppercase tracking-wide">Email</dt>
      <dd class="mt-1 text-sm font-medium text-navy-900"><%= @customer.email || "—" %></dd>
    </div>
    <div>
      <dt class="text-xs font-medium text-gray-400 uppercase tracking-wide">Customer Type</dt>
      <dd class="mt-1 text-sm font-medium text-navy-900"><%= String.capitalize(@customer.customer_type) %></dd>
    </div>
    <div>
      <dt class="text-xs font-medium text-gray-400 uppercase tracking-wide">Address</dt>
      <dd class="mt-1 text-sm font-medium text-navy-900">
        <%= [@customer.address_line, @customer.city, @customer.province, @customer.postal_code]
              |> Enum.reject(&(&1 in [nil, ""])) |> Enum.join(", ") |> then(&(if &1 == "", do: "—", else: &1)) %>
      </dd>
    </div>
    <div>
      <dt class="text-xs font-medium text-gray-400 uppercase tracking-wide">Status</dt>
      <dd class="mt-1">
        <%= if @customer.active do %>
          <span class="badge badge-active">Active</span>
        <% else %>
          <span class="badge badge-inactive">Inactive</span>
        <% end %>
      </dd>
    </div>
  </dl>
</div>

<%# KYC verification status %>
<div class="card p-6 mb-6">
  <div class="flex items-center justify-between mb-4">
    <h2 class="section-title">KYC Verification</h2>
    <span class={"badge badge-#{@customer.kyc_status}"}><%= @customer.kyc_status |> String.replace("_", " ") |> String.capitalize() %></span>
  </div>

  <%= if @customer.kyc_status == "rejected" and @customer.kyc_rejection_reason do %>
    <p class="text-sm text-red-600 mb-4">Rejected: <%= @customer.kyc_rejection_reason %></p>
  <% end %>

  <div class="flex gap-3 flex-wrap items-start">
    <%= if @customer.kyc_status in ["not_started", "rejected"] do %>
      <%= link "Submit for Review", to: ~p"/admin/customers/#{@customer}/kyc/submit", method: :patch, class: "btn-outline" %>
    <% end %>
    <%= if @customer.kyc_status == "pending_review" do %>
      <%= link "Mark Verified", to: ~p"/admin/customers/#{@customer}/kyc/verify", method: :patch, class: "btn-primary" %>
      <.form :let={f} for={%{}} as={:kyc} action={~p"/admin/customers/#{@customer}/kyc/reject"} method="patch" class="flex gap-2">
        <%= text_input f, :reason, placeholder: "Rejection reason",
              class: "block rounded-lg border-gray-300 text-sm shadow-sm focus:border-navy-600 focus:ring-navy-600" %>
        <%= submit "Reject", class: "btn-danger" %>
      </.form>
    <% end %>
  </div>
</div>

<%# Next of kin %>
<div class="card p-6 mb-6">
  <h2 class="section-title mb-4">Next of Kin <span class="ml-1.5 text-sm font-normal text-gray-400">(<%= length(@next_of_kins) %>)</span></h2>

  <%= if Enum.empty?(@next_of_kins) do %>
    <p class="text-sm text-gray-400 mb-4">None recorded.</p>
  <% else %>
    <ul class="divide-y divide-gray-50 mb-4">
      <%= for nok <- @next_of_kins do %>
        <li class="py-2.5 flex items-center justify-between">
          <div>
            <p class="text-sm font-medium text-navy-900"><%= nok.name %> <span class="text-gray-400 font-normal">(<%= nok.relationship %>)</span></p>
            <p class="text-xs text-gray-400"><%= nok.phone %></p>
          </div>
          <%= link "Remove", to: ~p"/admin/customers/#{@customer}/next_of_kin/#{nok}", method: :delete,
                data: [confirm: "Remove #{nok.name} as next of kin?"], class: "text-xs font-medium text-red-500 hover:text-red-700" %>
        </li>
      <% end %>
    </ul>
  <% end %>

  <.form :let={f} for={@next_of_kin_changeset} action={~p"/admin/customers/#{@customer}/next_of_kin"} as={:next_of_kin} class="grid grid-cols-1 sm:grid-cols-4 gap-3">
    <%= text_input f, :name, placeholder: "Name", class: "block w-full rounded-lg border-gray-300 text-sm shadow-sm focus:border-navy-600 focus:ring-navy-600" %>
    <%= text_input f, :relationship, placeholder: "Relationship", class: "block w-full rounded-lg border-gray-300 text-sm shadow-sm focus:border-navy-600 focus:ring-navy-600" %>
    <%= text_input f, :phone, placeholder: "Phone", class: "block w-full rounded-lg border-gray-300 text-sm shadow-sm focus:border-navy-600 focus:ring-navy-600" %>
    <%= submit "Add", class: "btn-outline" %>
  </.form>
</div>

<%# Guarantors %>
<div class="card p-6 mb-6">
  <h2 class="section-title mb-4">Guarantors <span class="ml-1.5 text-sm font-normal text-gray-400">(<%= length(@guarantors) %>)</span></h2>

  <%= if Enum.empty?(@guarantors) do %>
    <p class="text-sm text-gray-400 mb-4">None recorded.</p>
  <% else %>
    <ul class="divide-y divide-gray-50 mb-4">
      <%= for g <- @guarantors do %>
        <li class="py-2.5 flex items-center justify-between">
          <div>
            <p class="text-sm font-medium text-navy-900"><%= g.name %> <span class="text-gray-400 font-normal">(<%= g.relationship %>)</span></p>
            <p class="text-xs text-gray-400"><%= g.phone %> · <%= String.capitalize(g.id_type) %> <%= g.id_number %></p>
          </div>
          <%= link "Remove", to: ~p"/admin/customers/#{@customer}/guarantors/#{g}", method: :delete,
                data: [confirm: "Remove #{g.name} as guarantor?"], class: "text-xs font-medium text-red-500 hover:text-red-700" %>
        </li>
      <% end %>
    </ul>
  <% end %>

  <.form :let={f} for={@guarantor_changeset} action={~p"/admin/customers/#{@customer}/guarantors"} as={:guarantor} class="grid grid-cols-1 sm:grid-cols-3 gap-3">
    <%= text_input f, :name, placeholder: "Name", class: "block w-full rounded-lg border-gray-300 text-sm shadow-sm focus:border-navy-600 focus:ring-navy-600" %>
    <%= text_input f, :relationship, placeholder: "Relationship", class: "block w-full rounded-lg border-gray-300 text-sm shadow-sm focus:border-navy-600 focus:ring-navy-600" %>
    <%= text_input f, :phone, placeholder: "Phone", class: "block w-full rounded-lg border-gray-300 text-sm shadow-sm focus:border-navy-600 focus:ring-navy-600" %>
    <%= select f, :id_type, [{"NRC", "nrc"}, {"Passport", "passport"}, {"Company Registration", "company_registration"}],
          prompt: "ID type", class: "block w-full rounded-lg border-gray-300 text-sm shadow-sm focus:border-navy-600 focus:ring-navy-600" %>
    <%= text_input f, :id_number, placeholder: "ID number", class: "block w-full rounded-lg border-gray-300 text-sm shadow-sm focus:border-navy-600 focus:ring-navy-600" %>
    <%= submit "Add", class: "btn-outline" %>
  </.form>
</div>

<%# KYC documents — sensitive: never publicly accessible, only via the authenticated download action below %>
<div class="card p-6 mb-6">
  <h2 class="section-title mb-4">KYC Documents <span class="ml-1.5 text-sm font-normal text-gray-400">(<%= length(@kyc_documents) %>)</span></h2>

  <%= if Enum.empty?(@kyc_documents) do %>
    <p class="text-sm text-gray-400 mb-4">None uploaded.</p>
  <% else %>
    <ul class="divide-y divide-gray-50 mb-4">
      <%= for doc <- @kyc_documents do %>
        <li class="py-2.5 flex items-center justify-between">
          <div>
            <p class="text-sm font-medium text-navy-900"><%= doc.original_filename %></p>
            <p class="text-xs text-gray-400"><%= doc.document_type |> String.replace("_", " ") |> String.capitalize() %> · <%= doc.status %></p>
          </div>
          <div class="flex gap-3">
            <%= if doc.status == "active" do %>
              <%= link "Download", to: ~p"/admin/customers/#{@customer}/kyc_documents/#{doc}/download", class: "text-xs font-medium text-navy-600 hover:text-navy-900" %>
              <%= link "Remove", to: ~p"/admin/customers/#{@customer}/kyc_documents/#{doc}", method: :delete,
                    data: [confirm: "Remove this document?"], class: "text-xs font-medium text-red-500 hover:text-red-700" %>
            <% end %>
          </div>
        </li>
      <% end %>
    </ul>
  <% end %>

  <.form :let={f} for={@kyc_document_changeset} action={~p"/admin/customers/#{@customer}/kyc_documents"} as={:kyc_document}
        multipart={true} class="grid grid-cols-1 sm:grid-cols-3 gap-3">
    <%= select f, :document_type,
          [{"NRC copy", "nrc_copy"}, {"Passport copy", "passport_copy"}, {"Proof of address", "proof_of_address"},
           {"Payslip", "payslip"}, {"Business registration certificate", "business_registration_certificate"}, {"Other", "other"}],
          prompt: "Document type", class: "block w-full rounded-lg border-gray-300 text-sm shadow-sm focus:border-navy-600 focus:ring-navy-600" %>
    <%= file_input f, :file, class: "block w-full text-sm" %>
    <%= submit "Upload", class: "btn-outline" %>
  </.form>
</div>

<%# Consent %>
<div class="card p-6 mb-6">
  <h2 class="section-title mb-4">Consent Records <span class="ml-1.5 text-sm font-normal text-gray-400">(<%= length(@consents) %>)</span></h2>

  <%= if Enum.empty?(@consents) do %>
    <p class="text-sm text-gray-400 mb-4">None recorded.</p>
  <% else %>
    <ul class="divide-y divide-gray-50 mb-4">
      <%= for consent <- @consents do %>
        <li class="py-2.5 flex items-center justify-between">
          <div>
            <p class="text-sm font-medium text-navy-900"><%= consent.consent_type |> String.replace("_", " ") |> String.capitalize() %></p>
            <p class="text-xs text-gray-400">
              <%= String.capitalize(consent.method) %> · Granted <%= Calendar.strftime(consent.granted_at, "%d %b %Y") %>
              <%= if consent.revoked_at, do: " · Revoked #{Calendar.strftime(consent.revoked_at, "%d %b %Y")}" %>
            </p>
          </div>
          <%= if is_nil(consent.revoked_at) do %>
            <%= link "Revoke", to: ~p"/admin/customers/#{@customer}/consents/#{consent}", method: :delete,
                  data: [confirm: "Revoke this consent?"], class: "text-xs font-medium text-red-500 hover:text-red-700" %>
          <% end %>
        </li>
      <% end %>
    </ul>
  <% end %>

  <.form :let={f} for={@consent_changeset} action={~p"/admin/customers/#{@customer}/consents"} as={:consent} class="grid grid-cols-1 sm:grid-cols-3 gap-3">
    <%= select f, :consent_type,
          [{"Data processing", "data_processing"}, {"Credit check", "credit_check"}, {"Marketing communications", "marketing_communications"}, {"Other", "other"}],
          prompt: "Consent type", class: "block w-full rounded-lg border-gray-300 text-sm shadow-sm focus:border-navy-600 focus:ring-navy-600" %>
    <%= select f, :method, [{"Digital", "digital"}, {"Verbal", "verbal"}, {"Signed form", "signed_form"}],
          prompt: "Method", class: "block w-full rounded-lg border-gray-300 text-sm shadow-sm focus:border-navy-600 focus:ring-navy-600" %>
    <%= submit "Record", class: "btn-outline" %>
  </.form>
</div>

<%# Credit Reports (CRB checks) %>
<div class="card p-6 mb-6">
  <h2 class="section-title mb-4">Credit Reports <span class="ml-1.5 text-sm font-normal text-gray-400">(<%= length(@credit_reports) %>)</span></h2>

  <%= if Enum.empty?(@credit_reports) do %>
    <p class="text-sm text-gray-400 mb-4">None recorded.</p>
  <% else %>
    <ul class="divide-y divide-gray-50 mb-4">
      <%= for report <- @credit_reports do %>
        <li class="py-2.5">
          <div class="flex items-center justify-between">
            <p class="text-sm font-medium text-navy-900">
              <span class={if report.outcome == "clear", do: "text-emerald-600", else: "text-red-600"}>
                <%= String.capitalize(report.outcome) %>
              </span>
              <span class="text-gray-400 font-normal"><%= if report.score, do: " · Score #{report.score}" %></span>
            </p>
            <p class="text-xs text-gray-400">Checked <%= Calendar.strftime(report.checked_at, "%d %b %Y") %></p>
          </div>
          <%= if report.reference_number do %>
            <p class="text-xs text-gray-400">Ref: <%= report.reference_number %></p>
          <% end %>
          <%= if report.summary do %>
            <p class="text-xs text-gray-500 mt-0.5"><%= report.summary %></p>
          <% end %>
        </li>
      <% end %>
    </ul>
  <% end %>

  <%= if @has_credit_check_consent do %>
    <.form :let={f} for={@credit_report_changeset} action={~p"/admin/customers/#{@customer}/credit_reports"} as={:credit_report} class="grid grid-cols-1 sm:grid-cols-3 gap-3">
      <%= select f, :outcome, [{"Clear", "clear"}, {"Adverse", "adverse"}],
            prompt: "Outcome", class: "block w-full rounded-lg border-gray-300 text-sm shadow-sm focus:border-navy-600 focus:ring-navy-600" %>
      <%= number_input f, :score, placeholder: "Score (optional)", class: "block w-full rounded-lg border-gray-300 text-sm shadow-sm focus:border-navy-600 focus:ring-navy-600" %>
      <%= date_input f, :checked_at, value: input_value(f, :checked_at) || Date.utc_today(),
            class: "block w-full rounded-lg border-gray-300 text-sm shadow-sm focus:border-navy-600 focus:ring-navy-600" %>
      <%= text_input f, :reference_number, placeholder: "Bureau reference (optional)", class: "block w-full rounded-lg border-gray-300 text-sm shadow-sm focus:border-navy-600 focus:ring-navy-600 sm:col-span-2" %>
      <%= submit "Record", class: "btn-outline" %>
      <%= textarea f, :summary, rows: 2, placeholder: "Summary (optional)",
            class: "block w-full rounded-lg border-gray-300 text-sm shadow-sm focus:border-navy-600 focus:ring-navy-600 sm:col-span-3" %>
    </.form>
  <% else %>
    <p class="text-sm text-amber-600">This customer has no active credit-check consent on file — grant it in Consent Records above before recording a CRB report.</p>
  <% end %>
</div>

<%# Loan history %>
<div class="card overflow-hidden">
  <div class="flex items-center justify-between px-5 py-4 border-b border-gray-100">
    <h2 class="section-title">Loan History <span class="ml-1.5 text-sm font-normal text-gray-400">(<%= length(@applications) %>)</span></h2>
    <%= link "+ New Loan", to: ~p"/admin/loans/new", class: "text-sm font-medium text-gold-600 hover:text-gold-700" %>
  </div>

  <%= if Enum.empty?(@applications) do %>
    <div class="py-12 text-center">
      <p class="text-sm text-gray-400">No loans recorded for this customer.</p>
    </div>
  <% else %>
    <div class="overflow-x-auto">
      <table class="min-w-full">
        <thead>
          <tr class="bg-gray-50 border-b border-gray-100">
            <th class="th">Amount</th>
            <th class="th">Balance</th>
            <th class="th hidden sm:table-cell">Rate / Term</th>
            <th class="th">Status</th>
            <th class="th hidden md:table-cell">Date</th>
            <th class="th text-right">Action</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-50">
          <%= for application <- @applications do %>
            <tr class="hover:bg-gray-50 transition-colors">
              <td class="td font-medium text-navy-900">ZMW <%= application.requested_amount %></td>
              <td class="td">
                <%= if application.loan_account, do: "ZMW #{application.loan_account.outstanding_balance}", else: "—" %>
              </td>
              <td class="td text-gray-500 hidden sm:table-cell">
                <%= if application.loan_account do %>
                  <%= application.loan_account.interest_rate %>% / <%= application.loan_account.term_months %>mo
                <% else %>
                  —
                <% end %>
              </td>
              <td class="td">
                <% status = if application.loan_account, do: application.loan_account.status, else: application.status %>
                <span class={"badge badge-#{status}"}><%= String.capitalize(status) %></span>
              </td>
              <td class="td text-gray-400 hidden md:table-cell">
                <%= Calendar.strftime(application.inserted_at, "%d %b %Y") %>
              </td>
              <td class="td text-right">
                <%= link "View →", to: ~p"/admin/loans/#{application}", class: "text-sm font-medium text-navy-600 hover:text-navy-900" %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% end %>
</div>
