<div class="mb-6">
  <div class="flex items-center gap-2 text-sm text-gray-400 mb-1">
    <%= link "Customers", to: ~p"/admin/customers", class: "hover:text-navy-600" %>
    <span>›</span>
    <span class="text-navy-900 font-medium">New Customer</span>
  </div>
  <h1 class="text-2xl font-bold text-navy-900">Register New Customer</h1>
</div>

<div class="max-w-2xl">
  <.form :let={f} for={@changeset} action={~p"/admin/customers"} class="card p-6 space-y-5">

    <%= if @changeset.action do %>
      <div class="flex items-center gap-2.5 rounded-lg border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700">
        <svg class="h-4 w-4 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
          <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.28 7.22a.75.75 0 00-1.06 1.06L8.94 10l-1.72 1.72a.75.75 0 101.06 1.06L10 11.06l1.72 1.72a.75.75 0 101.06-1.06L11.06 10l1.72-1.72a.75.75 0 00-1.06-1.06L10 8.94 8.28 7.22z" clip-rule="evenodd"/>
        </svg>
        Please correct the errors below.
      </div>
    <% end %>

    <div>
      <label class="form-label">Full Name <span class="text-red-500">*</span></label>
      <%= text_input f, :name, placeholder: "e.g. Jane Mwansa",
            class: "block w-full rounded-lg border-gray-300 text-sm shadow-sm focus:border-navy-600 focus:ring-navy-600" %>
      <%= error_tag f, :name %>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      <div>
        <label class="form-label">Phone Number <span class="text-red-500">*</span></label>
        <p class="form-hint -mt-1 mb-1">Must start with 260 (e.g. 260971234567)</p>
        <%= text_input f, :phone, placeholder: "260971234567",
              class: "block w-full rounded-lg border-gray-300 text-sm shadow-sm focus:border-navy-600 focus:ring-navy-600" %>
        <%= error_tag f, :phone %>
      </div>

      <div>
        <label class="form-label">Email Address <span class="text-gray-400 font-normal">(optional)</span></label>
        <%= email_input f, :email, placeholder: "jane@example.com",
              class: "block w-full rounded-lg border-gray-300 text-sm shadow-sm focus:border-navy-600 focus:ring-navy-600" %>
        <%= error_tag f, :email %>
      </div>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      <div>
        <label class="form-label">Customer Type <span class="text-red-500">*</span></label>
        <%= select f, :customer_type, [{"Individual", "individual"}, {"Business", "business"}],
              prompt: "Select type",
              class: "block w-full rounded-lg border-gray-300 text-sm shadow-sm focus:border-navy-600 focus:ring-navy-600" %>
        <%= error_tag f, :customer_type %>
      </div>

      <div>
        <label class="form-label">Identity Document Type <span class="text-red-500">*</span></label>
        <%= select f, :id_type,
              [{"NRC", "nrc"}, {"Passport", "passport"}, {"Company Registration", "company_registration"}],
              prompt: "Select document type",
              class: "block w-full rounded-lg border-gray-300 text-sm shadow-sm focus:border-navy-600 focus:ring-navy-600" %>
        <p class="form-hint mt-1">Must match customer type — NRC/Passport for individuals, Company Registration for businesses.</p>
        <%= error_tag f, :id_type %>
      </div>
    </div>

    <div>
      <label class="form-label">Identity/Registration Number <span class="text-red-500">*</span></label>
      <%= text_input f, :id_number, placeholder: "e.g. 123456/78/1",
            class: "block w-full rounded-lg border-gray-300 text-sm shadow-sm focus:border-navy-600 focus:ring-navy-600" %>
      <%= error_tag f, :id_number %>
    </div>

    <div>
      <label class="form-label">Address <span class="text-gray-400 font-normal">(optional)</span></label>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
        <%= text_input f, :address_line, placeholder: "Street / plot",
              class: "block w-full rounded-lg border-gray-300 text-sm shadow-sm focus:border-navy-600 focus:ring-navy-600" %>
        <%= text_input f, :city, placeholder: "City / town",
              class: "block w-full rounded-lg border-gray-300 text-sm shadow-sm focus:border-navy-600 focus:ring-navy-600" %>
        <%= text_input f, :province, placeholder: "Province",
              class: "block w-full rounded-lg border-gray-300 text-sm shadow-sm focus:border-navy-600 focus:ring-navy-600" %>
        <%= text_input f, :postal_code, placeholder: "Postal code",
              class: "block w-full rounded-lg border-gray-300 text-sm shadow-sm focus:border-navy-600 focus:ring-navy-600" %>
      </div>
    </div>

    <div class="rounded-lg bg-gray-50 border border-gray-200 p-4 space-y-3">
      <p class="text-sm font-medium text-gray-700">Employment / Income <span class="text-gray-400 font-normal">(individuals, optional)</span></p>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
        <%= text_input f, :employment_status, placeholder: "Employment status",
              class: "block w-full rounded-lg border-gray-300 text-sm shadow-sm focus:border-navy-600 focus:ring-navy-600" %>
        <%= text_input f, :employer_name, placeholder: "Employer name",
              class: "block w-full rounded-lg border-gray-300 text-sm shadow-sm focus:border-navy-600 focus:ring-navy-600" %>
        <%= text_input f, :occupation, placeholder: "Occupation",
              class: "block w-full rounded-lg border-gray-300 text-sm shadow-sm focus:border-navy-600 focus:ring-navy-600" %>
        <%= number_input f, :monthly_income, step: "0.01", placeholder: "Monthly income (ZMW)",
              class: "block w-full rounded-lg border-gray-300 text-sm shadow-sm focus:border-navy-600 focus:ring-navy-600" %>
      </div>
    </div>

    <div class="rounded-lg bg-gray-50 border border-gray-200 p-4 space-y-3">
      <p class="text-sm font-medium text-gray-700">Business Details <span class="text-gray-400 font-normal">(businesses, optional)</span></p>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
        <%= text_input f, :business_type, placeholder: "Business type",
              class: "block w-full rounded-lg border-gray-300 text-sm shadow-sm focus:border-navy-600 focus:ring-navy-600" %>
        <%= number_input f, :annual_turnover, step: "0.01", placeholder: "Annual turnover (ZMW)",
              class: "block w-full rounded-lg border-gray-300 text-sm shadow-sm focus:border-navy-600 focus:ring-navy-600" %>
        <%= number_input f, :years_in_operation, placeholder: "Years in operation",
              class: "block w-full rounded-lg border-gray-300 text-sm shadow-sm focus:border-navy-600 focus:ring-navy-600" %>
      </div>
    </div>

    <div class="flex justify-end gap-3 pt-2 border-t border-gray-100">
      <%= link "Cancel", to: ~p"/admin/customers", class: "btn-outline" %>
      <%= submit "Create Customer", class: "btn-primary" %>
    </div>

  </.form>
</div>
