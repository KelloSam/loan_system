<%# Breadcrumb + header %>
<div class="mb-6 flex flex-col sm:flex-row sm:items-start sm:justify-between gap-3">
  <div>
    <div class="flex items-center gap-2 text-sm text-gray-400 mb-1">
      <%= link "Loans", to: ~p"/admin/loans", class: "hover:text-navy-600" %>
      <span>›</span>
      <span class="text-navy-900 font-medium"><%= @application.customer.name %></span>
    </div>
    <h1 class="text-2xl font-bold text-navy-900">Loan Application</h1>
    <p class="text-xs text-gray-400 mt-0.5 font-mono">
      #<%= String.slice(to_string(@application.id), 0, 8) %>
    </p>
  </div>
  <div class="flex flex-wrap gap-2">
    <%= if @application.status in ["pending", "referred"] do %>
      <%= link "Edit", to: ~p"/admin/loans/#{@application}/edit", class: "btn-outline" %>
      <details class="reject-disclosure">
        <summary class="btn-gold reject-toggle">Assess</summary>
        <div class="card p-4 mt-2">
          <.form :let={_f} for={%{}} as={:assess} action={~p"/admin/loans/#{@application}/assess"} method="patch">
            <label class="form-label" for="assess_notes">Assessment notes <span class="text-gray-400 font-normal">(optional)</span></label>
            <textarea
              id="assess_notes"
              name="notes"
              rows="3"
              placeholder="What did you find reviewing this application?"
            ></textarea>
            <div class="flex justify-end gap-2 mt-2">
              <button type="submit" class="btn-gold">Confirm Assess</button>
            </div>
          </.form>
        </div>
      </details>
      <%= link "Withdraw",
            to: ~p"/admin/loans/#{@application}/withdraw",
            method: :patch,
            data: [confirm: "Withdraw this application?"],
            class: "btn-outline" %>
    <% end %>
    <%= if @application.status == "under_review" do %>
      <%= link "Edit", to: ~p"/admin/loans/#{@application}/edit", class: "btn-outline" %>

      <details class="reject-disclosure">
        <summary class="btn-gold reject-toggle">Approve</summary>
        <div class="card p-4 mt-2">
          <.form :let={_f} for={%{}} as={:approve} action={~p"/admin/loans/#{@application}/approve"} method="patch">
            <label class="flex items-start gap-2 text-sm text-gray-700">
              <input type="checkbox" name="conflict_of_interest_confirmed" value="true" required
                     class="mt-0.5 h-4 w-4 rounded border-gray-300 text-navy-900 focus:ring-navy-600" />
              <span>I confirm I have no conflict of interest with this applicant</span>
            </label>
            <div class="flex justify-end gap-2 mt-2">
              <button type="submit" class="btn-gold">Confirm Approve</button>
            </div>
          </.form>
        </div>
      </details>

      <details class="reject-disclosure">
        <summary class="btn-danger reject-toggle">Reject</summary>
        <div class="card p-4 mt-2">
          <.form :let={_f} for={%{}} as={:reject} action={~p"/admin/loans/#{@application}/reject"} method="patch">
            <label class="form-label" for="reject_reason">Rejection reason</label>
            <textarea
              id="reject_reason"
              name="reason"
              rows="3"
              required
              placeholder="Why is this application being rejected?"
            ></textarea>
            <label class="form-label mt-2" for="decline_reason_category">Decline category</label>
            <select id="decline_reason_category" name="decline_reason_category"
                    class="block w-full rounded-lg border-gray-300 text-sm shadow-sm focus:border-navy-600 focus:ring-navy-600">
              <option value="insufficient_income">Insufficient income</option>
              <option value="poor_credit_history">Poor credit history</option>
              <option value="incomplete_documentation">Incomplete documentation</option>
              <option value="policy_violation">Policy violation</option>
              <option value="fraud_suspected">Fraud suspected</option>
              <option value="other">Other</option>
            </select>
            <div class="flex justify-end gap-2 mt-2">
              <button type="submit" class="btn-danger">Confirm Reject</button>
            </div>
          </.form>
        </div>
      </details>

      <details class="reject-disclosure">
        <summary class="btn-outline reject-toggle">Conditionally Approve</summary>
        <div class="card p-4 mt-2">
          <.form :let={_f} for={%{}} as={:conditionally_approve} action={~p"/admin/loans/#{@application}/conditionally_approve"} method="patch">
            <label class="form-label" for="conditions">Conditions</label>
            <textarea
              id="conditions"
              name="conditions"
              rows="3"
              required
              placeholder="What must be satisfied before this loan can be disbursed?"
            ></textarea>
            <label class="flex items-start gap-2 text-sm text-gray-700 mt-2">
              <input type="checkbox" name="conflict_of_interest_confirmed" value="true" required
                     class="mt-0.5 h-4 w-4 rounded border-gray-300 text-navy-900 focus:ring-navy-600" />
              <span>I confirm I have no conflict of interest with this applicant</span>
            </label>
            <div class="flex justify-end gap-2 mt-2">
              <button type="submit" class="btn-outline">Confirm Conditional Approval</button>
            </div>
          </.form>
        </div>
      </details>

      <details class="reject-disclosure">
        <summary class="btn-outline reject-toggle">Refer</summary>
        <div class="card p-4 mt-2">
          <.form :let={_f} for={%{}} as={:refer} action={~p"/admin/loans/#{@application}/refer"} method="patch">
            <label class="form-label" for="refer_reason">What's needed?</label>
            <textarea
              id="refer_reason"
              name="reason"
              rows="3"
              required
              placeholder="What additional information is required before this can be decided?"
            ></textarea>
            <div class="flex justify-end gap-2 mt-2">
              <button type="submit" class="btn-outline">Confirm Refer</button>
            </div>
          </.form>
        </div>
      </details>

      <%= link "Withdraw",
            to: ~p"/admin/loans/#{@application}/withdraw",
            method: :patch,
            data: [confirm: "Withdraw this application?"],
            class: "btn-outline" %>
    <% end %>
    <%= if @application.status == "approved" do %>
      <%= if @application.conditions && is_nil(@application.conditions_cleared_at) do %>
        <%= link "Clear Conditions",
              to: ~p"/admin/loans/#{@application}/clear_conditions",
              method: :patch,
              data: [confirm: "Confirm that all conditions have been met?"],
              class: "btn-outline" %>
      <% else %>
        <%= link "Disburse",
              to: ~p"/admin/loans/#{@application}/disburse",
              method: :patch,
              data: [confirm: "Disburse this loan? This creates the account and generates the repayment schedule."],
              class: "btn-gold" %>
      <% end %>
    <% end %>
    <%= link "All Loans", to: ~p"/admin/loans", class: "text-sm font-medium text-gray-400 hover:text-navy-600 self-center" %>
  </div>
</div>

<%# Fraud risk warning — shown while a decision is still pending (pending or under_review) %>
<%= if @fraud_signals != [] and @application.status in ["pending", "under_review"] do %>
  <div class="mb-6 rounded-xl border border-amber-300 bg-amber-50 p-4">
    <div class="flex items-start gap-3">
      <svg class="mt-0.5 h-5 w-5 flex-shrink-0 text-amber-500" fill="currentColor" viewBox="0 0 20 20">
        <path fill-rule="evenodd" d="M8.485 2.495c.673-1.167 2.357-1.167 3.03 0l6.28 10.875c.673 1.167-.17 2.625-1.516 2.625H3.72c-1.347 0-2.189-1.458-1.515-2.625L8.485 2.495zM10 5a.75.75 0 01.75.75v3.5a.75.75 0 01-1.5 0v-3.5A.75.75 0 0110 5zm0 9a1 1 0 100-2 1 1 0 000 2z" clip-rule="evenodd"/>
      </svg>
      <div>
        <h3 class="text-sm font-semibold text-amber-800">Fraud Risk Signals Detected</h3>
        <p class="mt-0.5 text-xs text-amber-700">Review the following carefully before approving this application.</p>
        <ul class="mt-2 space-y-1">
          <%= for signal <- @fraud_signals do %>
            <li class="flex items-start gap-1.5 text-xs text-amber-700">
              <span class="mt-0.5 font-bold">•</span>
              <span><%= signal %></span>
            </li>
          <% end %>
        </ul>
      </div>
    </div>
  </div>
<% end %>

<%# Summary cards %>
<div class="grid grid-cols-2 sm:grid-cols-3 gap-4 mb-6">
  <div class="card p-5">
    <p class="text-xs text-gray-400 uppercase tracking-wide font-medium">Requested</p>
    <p class="mt-1 text-xl font-bold text-navy-900">ZMW <%= @application.requested_amount %></p>
  </div>
  <div class="card p-5">
    <p class="text-xs text-gray-400 uppercase tracking-wide font-medium">Outstanding</p>
    <p class="mt-1 text-xl font-bold text-red-600">
      <%= if @account, do: "ZMW #{@account.outstanding_balance}", else: "—" %>
    </p>
  </div>
  <div class="card p-5 col-span-2 sm:col-span-1">
    <p class="text-xs text-gray-400 uppercase tracking-wide font-medium">Status</p>
    <% status = if @account, do: @account.status, else: @application.status %>
    <div class="mt-2 flex items-center gap-2 flex-wrap">
      <span class={"badge badge-#{status} text-sm px-3 py-1"}><%= String.capitalize(status) %></span>
      <span class={"text-xs font-semibold px-2.5 py-1 rounded-full #{risk_badge_class(@application.risk_level)}"}>
        <%= String.capitalize(@application.risk_level || "low") %> Risk
      </span>
    </div>
  </div>
</div>

<%# Application details + compound interest %>
<div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mb-6">

  <div class="card p-6">
    <h2 class="section-title mb-4">Loan Information</h2>
    <dl class="space-y-3">
      <div class="flex justify-between text-sm">
        <dt class="text-gray-500">Customer</dt>
        <dd class="font-medium text-navy-900"><%= @application.customer.name %></dd>
      </div>
      <%= if @account do %>
        <div class="flex justify-between text-sm">
          <dt class="text-gray-500">Annual Rate</dt>
          <dd class="font-medium text-navy-900"><%= @account.interest_rate %>%</dd>
        </div>
        <div class="flex justify-between text-sm">
          <dt class="text-gray-500">Term</dt>
          <dd class="font-medium text-navy-900"><%= @account.term_months %> months</dd>
        </div>
        <div class="flex justify-between text-sm">
          <dt class="text-gray-500">Opened</dt>
          <dd class="font-medium text-navy-900"><%= Calendar.strftime(@account.opened_at, "%d %b %Y") %></dd>
        </div>
      <% else %>
        <div class="flex justify-between text-sm">
          <dt class="text-gray-500">Requested Term</dt>
          <dd class="font-medium text-navy-900"><%= @application.requested_term_months %> months</dd>
        </div>
      <% end %>
      <%= if @application.assessed_at do %>
        <div class="flex justify-between text-sm">
          <dt class="text-gray-500">Assessed</dt>
          <dd class="font-medium text-navy-900"><%= Calendar.strftime(@application.assessed_at, "%d %b %Y") %></dd>
        </div>
      <% end %>
      <%= if @application.decided_at do %>
        <div class="flex justify-between text-sm">
          <dt class="text-gray-500">Decided</dt>
          <dd class="font-medium text-navy-900"><%= Calendar.strftime(@application.decided_at, "%d %b %Y") %></dd>
        </div>
      <% end %>
      <%= if @application.disbursed_at do %>
        <div class="flex justify-between text-sm">
          <dt class="text-gray-500">Disbursed</dt>
          <dd class="font-medium text-navy-900"><%= Calendar.strftime(@application.disbursed_at, "%d %b %Y") %></dd>
        </div>
      <% end %>
      <%= if @application.assessment_notes do %>
        <div class="pt-2 border-t border-gray-100 text-sm">
          <dt class="text-gray-500 mb-1">Assessment Notes</dt>
          <dd class="text-navy-900"><%= @application.assessment_notes %></dd>
        </div>
      <% end %>
      <%= if @application.rejection_reason do %>
        <div class="pt-2 border-t border-gray-100 text-sm">
          <dt class="text-gray-500 mb-1">Rejection Reason</dt>
          <dd class="text-navy-900"><%= @application.rejection_reason %></dd>
        </div>
      <% end %>
      <%= if @application.conditions do %>
        <div class="pt-2 border-t border-gray-100 text-sm">
          <dt class="text-gray-500 mb-1">
            Conditions
            <%= if @application.conditions_cleared_at do %>
              <span class="badge badge-approved ml-1">Cleared</span>
            <% else %>
              <span class="badge badge-pending ml-1">Outstanding</span>
            <% end %>
          </dt>
          <dd class="text-navy-900"><%= @application.conditions %></dd>
        </div>
      <% end %>
      <%= if @application.purpose do %>
        <div class="pt-2 border-t border-gray-100 text-sm">
          <dt class="text-gray-500 mb-1">Purpose</dt>
          <dd class="text-navy-900"><%= @application.purpose %></dd>
        </div>
      <% end %>
    </dl>
  </div>

  <%# Compound interest breakdown — only once an account exists %>
  <%= if @account do %>
    <div class="rounded-xl border-2 border-gold-200 bg-gold-50 p-6">
      <h2 class="section-title text-navy-900 mb-1">Interest Breakdown</h2>
      <p class="text-xs text-gray-500 mb-4">Monthly compounding</p>
      <dl class="space-y-3">
        <div class="flex justify-between items-center">
          <dt class="text-sm text-gray-600">Monthly Payment</dt>
          <dd class="text-base font-bold text-navy-900">ZMW <%= @interest.monthly_payment %></dd>
        </div>
        <div class="flex justify-between items-center">
          <dt class="text-sm text-gray-600">Total Repayment</dt>
          <dd class="text-base font-bold text-navy-900">ZMW <%= @interest.total_repayment %></dd>
        </div>
        <div class="flex justify-between items-center border-t border-gold-200 pt-3">
          <dt class="text-sm text-gray-600">Total Interest</dt>
          <dd class="text-base font-bold text-gold-700">ZMW <%= @interest.total_interest %></dd>
        </div>
        <div class="flex justify-between items-center">
          <dt class="text-sm text-gray-600">Effective Annual Rate</dt>
          <dd class="text-base font-bold text-navy-900"><%= @interest.effective_annual_rate %>%</dd>
        </div>
      </dl>
      <p class="mt-4 text-xs text-gray-500 bg-white/60 rounded-lg px-3 py-2">
        Lump-sum if no payments made: <strong>ZMW <%= @interest.compound_lump_sum %></strong>
      </p>
    </div>
  <% else %>
    <div class="rounded-xl border border-gray-200 bg-gray-50 p-6 flex items-center justify-center text-sm text-gray-400">
      Interest breakdown becomes available once this application is approved.
    </div>
  <% end %>

</div>

<%# Approval Trail — the operational view of a multi-level or committee application's progress, otherwise invisible %>
<%= if @application.approval_decisions != [] do %>
  <div class="card overflow-hidden mb-6">
    <div class="px-5 py-4 border-b border-gray-100">
      <h2 class="section-title">Approval Trail</h2>
    </div>
    <table class="min-w-full">
      <thead>
        <tr class="bg-gray-50 border-b border-gray-100">
          <th class="th">Level</th>
          <th class="th">Decision</th>
          <th class="th">By</th>
          <th class="th">When</th>
          <th class="th">Notes</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-50">
        <%= for decision <- @application.approval_decisions do %>
          <tr class="hover:bg-gray-50">
            <td class="td"><%= decision.level %></td>
            <td class="td">
              <span class={"badge badge-#{if decision.decision == "approved", do: "approved", else: "rejected"}"}>
                <%= String.capitalize(decision.decision) %>
              </span>
              <%= if decision.decline_reason_category do %>
                <span class="form-hint"><%= decision.decline_reason_category |> String.replace("_", " ") |> String.capitalize() %></span>
              <% end %>
            </td>
            <td class="td"><%= decision.decided_by.email %></td>
            <td class="td text-gray-400"><%= Calendar.strftime(decision.decided_at, "%d %b %Y %H:%M") %></td>
            <td class="td text-gray-500"><%= decision.notes || decision.conditions %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% end %>

<%# Collateral — only once an account exists (collateral secures a granted loan) %>
<%= if @account do %>
  <div class="card p-6 mb-6">
    <h2 class="section-title mb-4">
      Collateral
      <span class="ml-1.5 text-sm font-normal text-gray-400">(<%= length(@collaterals) %>)</span>
    </h2>

    <.form :let={f} for={@collateral_changeset} action={~p"/admin/loans/#{@application}/collateral"}
           class="grid grid-cols-1 sm:grid-cols-4 gap-4 items-end mb-5 pb-5 border-b border-gray-100">
      <div>
        <label class="form-label">Type</label>
        <%= select f, :type, [{"Vehicle", "vehicle"}, {"Land", "land"}, {"Electronics", "electronics"}, {"Other", "other"}],
              class: "block w-full rounded-lg border-gray-300 text-sm shadow-sm focus:border-navy-600 focus:ring-navy-600" %>
        <%= error_tag f, :type %>
      </div>
      <div>
        <label class="form-label">Description</label>
        <%= text_input f, :description, placeholder: "e.g. Toyota Hilux 2018, plate ABC 1234",
              class: "block w-full rounded-lg border-gray-300 text-sm shadow-sm focus:border-navy-600 focus:ring-navy-600" %>
        <%= error_tag f, :description %>
      </div>
      <div>
        <label class="form-label">Estimated Value (ZMW)</label>
        <%= number_input f, :estimated_value, step: "0.01", min: "0.01", placeholder: "0.00",
              class: "block w-full rounded-lg border-gray-300 text-sm shadow-sm focus:border-navy-600 focus:ring-navy-600" %>
        <%= error_tag f, :estimated_value %>
      </div>
      <div>
        <%= submit "Add Collateral", class: "btn-outline w-full" %>
      </div>
    </.form>

    <%= if Enum.empty?(@collaterals) do %>
      <div class="py-6 text-center text-sm text-gray-400">No collateral recorded for this loan.</div>
    <% else %>
      <table class="min-w-full">
        <thead>
          <tr class="bg-gray-50 border-b border-gray-100">
            <th class="th">Type</th>
            <th class="th">Description</th>
            <th class="th">Estimated Value</th>
            <th class="th"></th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-50">
          <%= for collateral <- @collaterals do %>
            <tr class="hover:bg-gray-50">
              <td class="td"><%= String.capitalize(collateral.type) %></td>
              <td class="td"><%= collateral.description %></td>
              <td class="td font-medium">ZMW <%= collateral.estimated_value %></td>
              <td class="td text-right">
                <%= link "Remove",
                      to: ~p"/admin/loans/#{@application}/collateral/#{collateral}",
                      method: :delete,
                      data: [confirm: "Remove this collateral record?"],
                      class: "text-xs font-medium text-red-600 hover:text-red-700" %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% end %>
  </div>
<% end %>

<%# Record payment — only for active accounts with an outstanding balance %>
<%= if @account && @account.status == "active" && Decimal.compare(@account.outstanding_balance, Decimal.new("0")) == :gt do %>
  <div class="card p-6 mb-6">
    <h2 class="section-title mb-4">Record Payment</h2>
    <.form :let={f} for={@payment_changeset} action={~p"/admin/loans/#{@application}/payments"}
           class="grid grid-cols-1 sm:grid-cols-4 gap-4 items-end">
      <div>
        <label class="form-label">Amount (ZMW)</label>
        <p class="form-hint -mt-1 mb-1">Max: ZMW <%= @account.outstanding_balance %></p>
        <%= number_input f, :amount, step: "0.01", min: "0.01", placeholder: "0.00",
              class: "block w-full rounded-lg border-gray-300 text-sm shadow-sm focus:border-navy-600 focus:ring-navy-600" %>
        <%= error_tag f, :amount %>
      </div>
      <div>
        <label class="form-label">Method</label>
        <%= select f, :method, [{"Cash", "cash"}, {"Bank Transfer", "bank_transfer"}, {"Mobile Money", "mobile_money"}, {"Cheque", "cheque"}, {"Other", "other"}],
              class: "block w-full rounded-lg border-gray-300 text-sm shadow-sm focus:border-navy-600 focus:ring-navy-600" %>
        <%= error_tag f, :method %>
      </div>
      <div>
        <label class="form-label">Date Received</label>
        <%= date_input f, :received_at,
              class: "block w-full rounded-lg border-gray-300 text-sm shadow-sm focus:border-navy-600 focus:ring-navy-600" %>
        <%= error_tag f, :received_at %>
      </div>
      <div>
        <%= submit "Record Payment", class: "btn-primary w-full" %>
      </div>
    </.form>
  </div>
<% end %>

<%# Repayment schedule %>
<%= if @account do %>
  <div class="card overflow-hidden mb-8">
    <div class="px-5 py-4 border-b border-gray-100">
      <h2 class="section-title">
        Repayment Schedule
        <span class="ml-1.5 text-sm font-normal text-gray-400">(<%= length(@installments) %>)</span>
      </h2>
    </div>
    <table class="min-w-full">
      <thead>
        <tr class="bg-gray-50 border-b border-gray-100">
          <th class="th">#</th>
          <th class="th">Due Date</th>
          <th class="th">Amount</th>
          <th class="th">Paid</th>
          <th class="th">Status</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-50">
        <%= for installment <- @installments do %>
          <tr class="hover:bg-gray-50">
            <td class="td"><%= installment.installment_number %></td>
            <td class="td"><%= installment.due_date %></td>
            <td class="td font-medium">ZMW <%= installment.scheduled_amount %></td>
            <td class="td">ZMW <%= installment.paid_amount %></td>
            <td class="td">
              <span class={"badge badge-#{installment.status}"}><%= String.capitalize(installment.status) %></span>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <%# Payment transactions %>
  <div class="card overflow-hidden">
    <div class="px-5 py-4 border-b border-gray-100">
      <h2 class="section-title">
        Payments Received
        <span class="ml-1.5 text-sm font-normal text-gray-400">(<%= length(@transactions) %>)</span>
      </h2>
    </div>
    <%= if Enum.empty?(@transactions) do %>
      <div class="py-10 text-center text-sm text-gray-400">No payments recorded yet.</div>
    <% else %>
      <table class="min-w-full">
        <thead>
          <tr class="bg-gray-50 border-b border-gray-100">
            <th class="th">Date</th>
            <th class="th">Amount</th>
            <th class="th">Method</th>
            <th class="th">Status</th>
            <th class="th"></th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-50">
          <%= for transaction <- @transactions do %>
            <tr class="hover:bg-gray-50">
              <td class="td"><%= Calendar.strftime(transaction.received_at, "%d %b %Y") %></td>
              <td class="td font-medium">ZMW <%= transaction.amount %></td>
              <td class="td"><%= String.capitalize(String.replace(transaction.method, "_", " ")) %></td>
              <td class="td">
                <span class={"badge badge-#{transaction.status}"}><%= String.capitalize(transaction.status) %></span>
                <%= if transaction.status == "voided" and transaction.void_reason do %>
                  <span class="form-hint"><%= transaction.void_reason %></span>
                <% end %>
              </td>
              <td class="td text-right">
                <%= if transaction.status == "posted" do %>
                  <details class="void-disclosure">
                    <summary class="btn-outline void-toggle">Void</summary>
                    <div class="card p-4 mt-2">
                      <.form :let={_f} for={%{}} as={:void} action={~p"/admin/loans/#{@application}/payments/#{transaction}/void"} method="patch">
                        <label class="form-label" for={"void_reason_#{transaction.id}"}>Void reason</label>
                        <textarea
                          id={"void_reason_#{transaction.id}"}
                          name="reason"
                          rows="3"
                          required
                          placeholder="Why is this payment being voided?"
                        ></textarea>
                        <div class="flex justify-end gap-2 mt-2">
                          <button type="submit" class="btn-danger">Confirm Void</button>
                        </div>
                      </.form>
                    </div>
                  </details>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% end %>
  </div>
<% end %>
