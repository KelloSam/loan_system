<div class="mb-6 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
  <div>
    <h1 class="text-2xl font-bold text-navy-900">Loans</h1>
    <p class="mt-0.5 text-sm text-gray-500">All loan applications in the system</p>
  </div>
  <%= link "New Loan", to: ~p"/admin/loans/new", class: "btn-primary self-start" %>
</div>

<div class="card overflow-hidden">
  <div class="overflow-x-auto">
    <table class="min-w-full">
      <thead>
        <tr class="bg-gray-50 border-b border-gray-100">
          <th class="th">Client</th>
          <th class="th">Requested</th>
          <th class="th hidden sm:table-cell">Balance</th>
          <th class="th hidden md:table-cell">Rate / Term</th>
          <th class="th">Status</th>
          <th class="th hidden sm:table-cell">Risk</th>
          <th class="th hidden lg:table-cell">Created</th>
          <th class="th text-right">Actions</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-50">
        <%= for application <- @applications do %>
          <tr class="hover:bg-gray-50 transition-colors">
            <td class="td">
              <p class="font-medium text-navy-900"><%= application.client.name %></p>
            </td>
            <td class="td font-medium">ZMW <%= application.requested_amount %></td>
            <td class="td text-gray-500 hidden sm:table-cell">
              <%= if application.loan_account do %>
                ZMW <%= application.loan_account.outstanding_balance %>
              <% else %>
                —
              <% end %>
            </td>
            <td class="td text-gray-500 hidden md:table-cell">
              <%= if application.loan_account do %>
                <%= application.loan_account.interest_rate %>% / <%= application.loan_account.term_months %>mo
              <% else %>
                —
              <% end %>
            </td>
            <td class="td">
              <% status = if application.loan_account, do: application.loan_account.status, else: application.status %>
              <span class={"badge badge-#{status}"}><%= String.capitalize(status) %></span>
            </td>
            <td class="td hidden sm:table-cell">
              <span class={"text-xs font-semibold px-2 py-0.5 rounded-full #{risk_badge_class(application.risk_level)}"}>
                <%= String.capitalize(application.risk_level || "low") %>
              </span>
            </td>
            <td class="td text-gray-400 hidden lg:table-cell">
              <%= Calendar.strftime(application.inserted_at, "%d %b %Y") %>
            </td>
            <td class="td text-right space-x-3">
              <%= link "View", to: ~p"/admin/loans/#{application}", class: "text-sm font-medium text-navy-600 hover:text-navy-900" %>
              <%= if application.status == "pending" do %>
                <%= link "Edit", to: ~p"/admin/loans/#{application}/edit", class: "text-sm font-medium text-gray-400 hover:text-gray-700" %>
              <% end %>
            </td>
          </tr>
        <% end %>
        <%= if Enum.empty?(@applications) do %>
          <tr>
            <td colspan="8" class="py-12 text-center text-sm text-gray-400">No loans found.</td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
