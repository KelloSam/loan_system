<div class="mb-6">
  <div class="flex items-center gap-2 text-sm text-gray-400 mb-1">
    <%= link "Loans", to: ~p"/admin/loans", class: "hover:text-navy-600" %>
    <span>›</span>
    <span class="text-navy-900 font-medium">New Loan</span>
  </div>
  <h1 class="text-2xl font-bold text-navy-900">Originate New Loan</h1>
</div>

<div class="max-w-2xl">
  <.form :let={f} for={@changeset} action={~p"/admin/loans"} class="card p-6 space-y-5">

    <%= if @changeset.action do %>
      <div class="flex items-center gap-2.5 rounded-lg border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700">
        <svg class="h-4 w-4 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
          <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.28 7.22a.75.75 0 00-1.06 1.06L8.94 10l-1.72 1.72a.75.75 0 101.06 1.06L10 11.06l1.72 1.72a.75.75 0 101.06-1.06L11.06 10l1.72-1.72a.75.75 0 00-1.06-1.06L10 8.94 8.28 7.22z" clip-rule="evenodd"/>
        </svg>
        Please correct the errors below.
      </div>
    <% end %>

    <div>
      <label class="form-label">Client <span class="text-red-500">*</span></label>
      <%= select f, :client_id,
            Enum.map(@clients, &{&1.name, &1.id}),
            prompt: "Select a client…",
            class: "block w-full rounded-lg border-gray-300 text-sm shadow-sm focus:border-navy-600 focus:ring-navy-600" %>
      <%= error_tag f, :client_id %>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      <div>
        <label class="form-label">Principal Amount (ZMW) <span class="text-red-500">*</span></label>
        <%= number_input f, :amount, step: "0.01", min: "0", placeholder: "e.g. 5000.00",
              class: "block w-full rounded-lg border-gray-300 text-sm shadow-sm focus:border-navy-600 focus:ring-navy-600" %>
        <%= error_tag f, :amount %>
      </div>

      <div>
        <label class="form-label">Annual Interest Rate (%) <span class="text-red-500">*</span></label>
        <%= number_input f, :interest_rate, step: "0.01", min: "0", placeholder: "e.g. 18.00",
              class: "block w-full rounded-lg border-gray-300 text-sm shadow-sm focus:border-navy-600 focus:ring-navy-600" %>
        <%= error_tag f, :interest_rate %>
      </div>

      <div>
        <label class="form-label">Term (months) <span class="text-red-500">*</span></label>
        <%= number_input f, :term_months, min: "1", placeholder: "e.g. 12",
              class: "block w-full rounded-lg border-gray-300 text-sm shadow-sm focus:border-navy-600 focus:ring-navy-600" %>
        <%= error_tag f, :term_months %>
      </div>

      <div>
        <label class="form-label">First Payment Date</label>
        <%= date_input f, :next_payment_date,
              class: "block w-full rounded-lg border-gray-300 text-sm shadow-sm focus:border-navy-600 focus:ring-navy-600" %>
        <%= error_tag f, :next_payment_date %>
      </div>
    </div>

    <div>
      <label class="form-label">Purpose <span class="text-gray-400 font-normal">(optional)</span></label>
      <%= textarea f, :purpose, rows: 3, placeholder: "Brief description of the loan purpose…",
            class: "block w-full rounded-lg border-gray-300 text-sm shadow-sm focus:border-navy-600 focus:ring-navy-600" %>
      <%= error_tag f, :purpose %>
    </div>

    <div class="flex justify-end gap-3 pt-2 border-t border-gray-100">
      <%= link "Cancel", to: ~p"/admin/loans", class: "btn-outline" %>
      <%= submit "Create Loan", class: "btn-primary" %>
    </div>

  </.form>
</div>
