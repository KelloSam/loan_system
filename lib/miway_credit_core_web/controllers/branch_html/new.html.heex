<div class="mb-6">
  <div class="flex items-center gap-2 text-sm text-gray-400 mb-1">
    <%= link "Branches", to: ~p"/admin/branches", class: "hover:text-navy-600" %>
    <span>›</span>
    <span class="text-navy-900 font-medium">New Branch</span>
  </div>
  <h1 class="text-2xl font-bold text-navy-900">New Branch</h1>
</div>

<div class="max-w-2xl">
  <.form :let={f} for={@changeset} action={~p"/admin/branches"} class="card p-6 space-y-5">

    <%= if @changeset.action do %>
      <div class="flex items-center gap-2.5 rounded-lg border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700">
        Please correct the errors below.
      </div>
    <% end %>

    <div>
      <label class="form-label">Name <span class="text-red-500">*</span></label>
      <%= text_input f, :name, placeholder: "e.g. Lusaka Main Branch",
            class: "block w-full rounded-lg border-gray-300 text-sm shadow-sm focus:border-navy-600 focus:ring-navy-600" %>
      <%= error_tag f, :name %>
    </div>

    <div>
      <label class="form-label">Code <span class="text-red-500">*</span></label>
      <%= text_input f, :code, placeholder: "e.g. LSK1",
            class: "block w-full sm:w-1/2 rounded-lg border-gray-300 text-sm shadow-sm focus:border-navy-600 focus:ring-navy-600" %>
      <p class="form-hint mt-1">Must be unique within your organisation.</p>
      <%= error_tag f, :code %>
    </div>

    <div>
      <label class="form-label">Address <span class="text-gray-400 font-normal">(optional)</span></label>
      <%= textarea f, :address, rows: 2,
            class: "block w-full rounded-lg border-gray-300 text-sm shadow-sm focus:border-navy-600 focus:ring-navy-600" %>
    </div>

    <div class="flex justify-end gap-3 pt-2 border-t border-gray-100">
      <%= link "Cancel", to: ~p"/admin/branches", class: "btn-outline" %>
      <%= submit "Create Branch", class: "btn-primary" %>
    </div>

  </.form>
</div>
