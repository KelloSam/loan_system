<%# Page header %>
<div class="mb-6 flex items-center justify-between">
  <div>
    <h1 class="text-2xl font-bold text-navy-900">Reports</h1>
    <p class="mt-0.5 text-sm text-gray-500">Portfolio overview, arrears, and upcoming payments.</p>
  </div>
  <%= link "Export Loans (CSV)", to: ~p"/admin/reports/export.csv", class: "btn-outline" %>
</div>

<%# Stat cards %>
<div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4 mb-8">
  <div class="card p-5">
    <p class="text-sm font-medium text-gray-500">Outstanding Balance</p>
    <p class="stat-value">ZMW <%= @summary.outstanding_balance %></p>
    <p class="mt-1 text-xs text-gray-400"><%= @summary.active_loans %> active loans</p>
  </div>

  <div class="card p-5">
    <p class="text-sm font-medium text-gray-500">Overdue</p>
    <p class="stat-value text-red-600">ZMW <%= @summary.overdue_amount %></p>
    <p class="mt-1 text-xs text-gray-400"><%= @summary.overdue_count %> installment(s) past due</p>
  </div>

  <div class="card p-5">
    <p class="text-sm font-medium text-gray-500">Portfolio</p>
    <p class="stat-value"><%= @summary.total_loans %></p>
    <p class="mt-1 text-xs text-gray-400"><%= @summary.total_customers %> customers on record</p>
  </div>

  <div class="card p-5">
    <p class="text-sm font-medium text-gray-500">Portfolio at Risk</p>
    <p class={"stat-value #{if Decimal.compare(@summary.par_percent, Decimal.new("5")) == :gt, do: "text-red-600", else: ""}"}>
      <%= @summary.par_percent %>%
    </p>
    <p class="mt-1 text-xs text-gray-400"><%= @summary.open_collection_cases %> open collection case(s)</p>
  </div>
</div>

<%# Ledger health %>
<div class="card overflow-hidden mb-8">
  <div class="px-5 py-4 border-b border-gray-100 flex items-center justify-between">
    <h2 class="section-title">Ledger</h2>
    <span class={"badge #{if @ledger_health.balanced?, do: "badge-disbursed", else: "badge-rejected"}"}>
      <%= if @ledger_health.balanced?, do: "Balanced", else: "Out of balance" %>
    </span>
  </div>
  <div class="p-5 grid grid-cols-1 sm:grid-cols-2 gap-6">
    <div>
      <p class="text-sm font-medium text-gray-500 mb-1">Trial Balance</p>
      <p class="text-sm text-gray-700">Debits: ZMW <%= @ledger_health.total_debits %></p>
      <p class="text-sm text-gray-700">Credits: ZMW <%= @ledger_health.total_credits %></p>
    </div>
    <div>
      <p class="text-sm font-medium text-gray-500 mb-2">Cash Position</p>
      <%= if Enum.empty?(@cash_position) do %>
        <p class="text-sm text-gray-400">No cash accounts yet.</p>
      <% else %>
        <table class="min-w-full">
          <tbody class="divide-y divide-gray-50">
            <%= for account <- @cash_position do %>
              <tr>
                <td class="td text-sm text-gray-700"><%= account.name %></td>
                <td class="td text-sm font-medium text-right">ZMW <%= account.balance %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      <% end %>
    </div>
  </div>
</div>

<%# Overdue payments %>
<div class="card overflow-hidden mb-8">
  <div class="px-5 py-4 border-b border-gray-100">
    <h2 class="section-title">
      Overdue Installments
      <span class="ml-1.5 text-sm font-normal text-gray-400">(<%= length(@overdue_payments) %>)</span>
    </h2>
  </div>
  <%= if Enum.empty?(@overdue_payments) do %>
    <div class="py-10 text-center text-sm text-gray-400">Nothing overdue right now.</div>
  <% else %>
    <table class="min-w-full">
      <thead>
        <tr class="bg-gray-50 border-b border-gray-100">
          <th class="th">Customer</th>
          <th class="th">Loan</th>
          <th class="th">Due Date</th>
          <th class="th">Amount</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-50">
        <%= for installment <- @overdue_payments do %>
          <tr class="hover:bg-gray-50">
            <td class="td"><%= installment.loan_account.customer.name %></td>
            <td class="td">
              <%= link "View", to: ~p"/admin/loans/#{installment.loan_account.loan_application_id}", class: "text-navy-600 hover:underline" %>
            </td>
            <td class="td text-red-600 font-medium"><%= installment.due_date %></td>
            <td class="td font-medium">ZMW <%= Decimal.sub(installment.scheduled_amount, installment.paid_amount) %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% end %>
</div>

<%# Payments due soon %>
<div class="card overflow-hidden">
  <div class="px-5 py-4 border-b border-gray-100">
    <h2 class="section-title">
      Due in the Next 7 Days
      <span class="ml-1.5 text-sm font-normal text-gray-400">(<%= length(@payments_due_soon) %>)</span>
    </h2>
  </div>
  <%= if Enum.empty?(@payments_due_soon) do %>
    <div class="py-10 text-center text-sm text-gray-400">Nothing due in the next 7 days.</div>
  <% else %>
    <table class="min-w-full">
      <thead>
        <tr class="bg-gray-50 border-b border-gray-100">
          <th class="th">Customer</th>
          <th class="th">Loan</th>
          <th class="th">Due Date</th>
          <th class="th">Amount</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-50">
        <%= for installment <- @payments_due_soon do %>
          <tr class="hover:bg-gray-50">
            <td class="td"><%= installment.loan_account.customer.name %></td>
            <td class="td">
              <%= link "View", to: ~p"/admin/loans/#{installment.loan_account.loan_application_id}", class: "text-navy-600 hover:underline" %>
            </td>
            <td class="td"><%= installment.due_date %></td>
            <td class="td font-medium">ZMW <%= Decimal.sub(installment.scheduled_amount, installment.paid_amount) %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% end %>
</div>
