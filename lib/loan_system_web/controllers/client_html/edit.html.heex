<div class="mb-6">
  <div class="flex items-center gap-2 text-sm text-gray-400 mb-1">
    <%= link "Clients", to: ~p"/admin/clients", class: "hover:text-navy-600" %>
    <span>›</span>
    <%= link @client.name, to: ~p"/admin/clients/#{@client}", class: "hover:text-navy-600" %>
    <span>›</span>
    <span class="text-navy-900 font-medium">Edit</span>
  </div>
  <h1 class="text-2xl font-bold text-navy-900">Edit Client</h1>
</div>

<div class="max-w-2xl">
  <.form :let={f} for={@changeset} action={~p"/admin/clients/#{@client}"} method="put" class="card p-6 space-y-5">

    <%= if @changeset.action do %>
      <div class="flex items-center gap-2.5 rounded-lg border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700">
        <svg class="h-4 w-4 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
          <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.28 7.22a.75.75 0 00-1.06 1.06L8.94 10l-1.72 1.72a.75.75 0 101.06 1.06L10 11.06l1.72 1.72a.75.75 0 101.06-1.06L11.06 10l1.72-1.72a.75.75 0 00-1.06-1.06L10 8.94 8.28 7.22z" clip-rule="evenodd"/>
        </svg>
        Please correct the errors below.
      </div>
    <% end %>

    <div>
      <label class="form-label">Full Name <span class="text-red-500">*</span></label>
      <%= text_input f, :name,
            class: "block w-full rounded-lg border-gray-300 text-sm shadow-sm focus:border-navy-600 focus:ring-navy-600" %>
      <%= error_tag f, :name %>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      <div>
        <label class="form-label">Phone Number <span class="text-red-500">*</span></label>
        <p class="form-hint -mt-1 mb-1">Must start with 260</p>
        <%= text_input f, :phone,
              class: "block w-full rounded-lg border-gray-300 text-sm shadow-sm focus:border-navy-600 focus:ring-navy-600" %>
        <%= error_tag f, :phone %>
      </div>

      <div>
        <label class="form-label">National ID Number <span class="text-red-500">*</span></label>
        <%= text_input f, :id_number,
              class: "block w-full rounded-lg border-gray-300 text-sm shadow-sm focus:border-navy-600 focus:ring-navy-600" %>
        <%= error_tag f, :id_number %>
      </div>
    </div>

    <div>
      <label class="form-label">Email Address <span class="text-gray-400 font-normal">(optional)</span></label>
      <%= email_input f, :email,
            class: "block w-full rounded-lg border-gray-300 text-sm shadow-sm focus:border-navy-600 focus:ring-navy-600" %>
      <%= error_tag f, :email %>
    </div>

    <div>
      <label class="form-label">Address <span class="text-gray-400 font-normal">(optional)</span></label>
      <%= textarea f, :address, rows: 2,
            class: "block w-full rounded-lg border-gray-300 text-sm shadow-sm focus:border-navy-600 focus:ring-navy-600" %>
    </div>

    <div class="rounded-lg bg-gray-50 border border-gray-200 p-4">
      <label class="flex items-center gap-3 cursor-pointer">
        <%= checkbox f, :active, class: "h-4 w-4 rounded border-gray-300 text-navy-900 focus:ring-navy-600" %>
        <div>
          <p class="text-sm font-medium text-gray-700">Active client</p>
          <p class="text-xs text-gray-400">Inactive clients are excluded from new loan origination</p>
        </div>
      </label>
    </div>

    <div class="flex justify-between pt-2 border-t border-gray-100">
      <div>
        <%= if @client.total_loans == 0 do %>
          <%= link "Delete Client",
                to: ~p"/admin/clients/#{@client}",
                method: :delete,
                data: [confirm: "Permanently delete #{@client.name}? This cannot be undone."],
                class: "btn-danger" %>
        <% end %>
      </div>
      <div class="flex gap-3">
        <%= link "Cancel", to: ~p"/admin/clients/#{@client}", class: "btn-outline" %>
        <%= submit "Save Changes", class: "btn-primary" %>
      </div>
    </div>

  </.form>
</div>
