<%# Page header %>
<div class="mb-6 flex items-center justify-between">
  <div>
    <h1 class="text-2xl font-bold text-navy-900">Dashboard</h1>
    <p class="mt-0.5 text-sm text-gray-500">Welcome back — here's what's happening today.</p>
  </div>
  <div class="text-sm text-gray-400"><%= Calendar.strftime(Date.utc_today(), "%d %B %Y") %></div>
</div>

<%# Stat cards %>
<div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4 mb-8">

  <div class="card p-5">
    <div class="flex items-center justify-between">
      <p class="text-sm font-medium text-gray-500">Total Clients</p>
      <div class="flex h-9 w-9 items-center justify-center rounded-lg bg-navy-50">
        <svg class="h-5 w-5 text-navy-600" fill="none" stroke="currentColor" stroke-width="1.75" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15 19.128a9.38 9.38 0 002.625.372 9.337 9.337 0 004.121-.952 4.125 4.125 0 00-7.533-2.493M15 19.128v-.003c0-1.113-.285-2.16-.786-3.07M15 19.128v.106A12.318 12.318 0 018.624 21c-2.331 0-4.512-.645-6.374-1.766l-.001-.109a6.375 6.375 0 0111.964-3.07M12 6.375a3.375 3.375 0 11-6.75 0 3.375 3.375 0 016.75 0zm8.25 2.25a2.625 2.625 0 11-5.25 0 2.625 2.625 0 015.25 0z"/>
        </svg>
      </div>
    </div>
    <p class="stat-value"><%= @stats.total_clients %></p>
    <p class="mt-1 text-xs text-gray-400">Registered clients</p>
  </div>

  <div class="card p-5">
    <div class="flex items-center justify-between">
      <p class="text-sm font-medium text-gray-500">Total Loans</p>
      <div class="flex h-9 w-9 items-center justify-center rounded-lg bg-gold-100">
        <svg class="h-5 w-5 text-gold-600" fill="none" stroke="currentColor" stroke-width="1.75" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 18.75a60.07 60.07 0 0115.797 2.101c.727.198 1.453-.342 1.453-1.096V18.75M3.75 4.5v.75A.75.75 0 013 6h-.75m0 0v-.375c0-.621.504-1.125 1.125-1.125H20.25M2.25 6v9m18-10.5v.75c0 .414.336.75.75.75h.75m-1.5-1.5h.375c.621 0 1.125.504 1.125 1.125v9.75c0 .621-.504 1.125-1.125 1.125h-.375m1.5-1.5H21a.75.75 0 00-.75.75v.75m0 0H3.75m0 0h-.375a1.125 1.125 0 01-1.125-1.125V15m1.5 1.5v-.75A.75.75 0 003 15h-.75"/>
        </svg>
      </div>
    </div>
    <p class="stat-value"><%= @stats.total_loans %></p>
    <p class="mt-1 text-xs text-gray-400">All time</p>
  </div>

  <div class="card p-5">
    <div class="flex items-center justify-between">
      <p class="text-sm font-medium text-gray-500">Active Loans</p>
      <div class="flex h-9 w-9 items-center justify-center rounded-lg bg-amber-50">
        <svg class="h-5 w-5 text-amber-600" fill="none" stroke="currentColor" stroke-width="1.75" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z"/>
        </svg>
      </div>
    </div>
    <p class="stat-value"><%= @stats.active_loans %></p>
    <p class="mt-1 text-xs text-gray-400">Pending & approved</p>
  </div>

  <div class="card p-5">
    <div class="flex items-center justify-between">
      <p class="text-sm font-medium text-gray-500">Outstanding</p>
      <div class="flex h-9 w-9 items-center justify-center rounded-lg bg-red-50">
        <svg class="h-5 w-5 text-red-500" fill="none" stroke="currentColor" stroke-width="1.75" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v12m-3-2.818l.879.659c1.171.879 3.07.879 4.242 0 1.172-.879 1.172-2.303 0-3.182C13.536 12.219 12.768 12 12 12c-.725 0-1.45-.22-2.003-.659-1.106-.879-1.106-2.303 0-3.182s2.9-.879 4.006 0l.415.33M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
        </svg>
      </div>
    </div>
    <p class="stat-value text-2xl">ZMW <%= @stats.outstanding_balance %></p>
    <p class="mt-1 text-xs text-gray-400">Remaining balance</p>
  </div>

</div>

<%# Recent loans + Quick actions %>
<div class="grid grid-cols-1 gap-6 lg:grid-cols-3">

  <%# Recent loans table %>
  <div class="card lg:col-span-2">
    <div class="flex items-center justify-between px-5 py-4 border-b border-gray-100">
      <h2 class="section-title">Recent Loans</h2>
      <%= link "View all →", to: ~p"/admin/loans", class: "text-sm font-medium text-navy-600 hover:text-navy-900" %>
    </div>
    <div class="overflow-x-auto">
      <table class="min-w-full">
        <thead>
          <tr class="bg-gray-50 border-b border-gray-100">
            <th class="th">Client</th>
            <th class="th">Amount</th>
            <th class="th">Status</th>
            <th class="th hidden sm:table-cell">Date</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-50">
          <%= for loan <- @recent_loans do %>
            <tr class="hover:bg-gray-50 transition-colors">
              <td class="td font-medium text-navy-900"><%= loan.client.name %></td>
              <td class="td">ZMW <%= loan.amount %></td>
              <td class="td">
                <span class={"badge badge-#{loan.status}"}><%= String.capitalize(loan.status) %></span>
              </td>
              <td class="td text-gray-400 hidden sm:table-cell">
                <%= Calendar.strftime(loan.inserted_at, "%d %b %Y") %>
              </td>
            </tr>
          <% end %>
          <%= if Enum.empty?(@recent_loans) do %>
            <tr><td colspan="4" class="py-8 text-center text-sm text-gray-400">No loans yet.</td></tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>

  <%# Quick actions %>
  <div class="card p-5">
    <h2 class="section-title mb-4">Quick Actions</h2>
    <div class="space-y-3">
      <a href={~p"/admin/clients/new"} class="quick-action">
        <div style="width:32px;height:32px;background:#0B1A2E;border-radius:8px;display:flex;align-items:center;justify-content:center;flex-shrink:0;">
          <svg style="width:14px;height:14px;stroke:#C8970A;fill:none;" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15"/>
          </svg>
        </div>
        <div>
          <p class="text-sm font-medium" style="color:#0B1A2E;">New Client</p>
          <p class="text-xs text-gray-400">Register a client</p>
        </div>
      </a>

      <a href={~p"/admin/loans/new"} class="quick-action">
        <div style="width:32px;height:32px;background:#C8970A;border-radius:8px;display:flex;align-items:center;justify-content:center;flex-shrink:0;">
          <svg style="width:14px;height:14px;stroke:#0B1A2E;fill:none;" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15"/>
          </svg>
        </div>
        <div>
          <p class="text-sm font-medium" style="color:#0B1A2E;">New Loan</p>
          <p class="text-xs text-gray-400">Originate a loan</p>
        </div>
      </a>

      <a href={~p"/admin/clients"} class="quick-action">
        <div style="width:32px;height:32px;background:#F3F4F6;border-radius:8px;display:flex;align-items:center;justify-content:center;flex-shrink:0;">
          <svg style="width:14px;height:14px;stroke:#6B7280;fill:none;" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15 19.128a9.38 9.38 0 002.625.372 9.337 9.337 0 004.121-.952 4.125 4.125 0 00-7.533-2.493M15 19.128v-.003c0-1.113-.285-2.16-.786-3.07M15 19.128v.106A12.318 12.318 0 018.624 21c-2.331 0-4.512-.645-6.374-1.766l-.001-.109a6.375 6.375 0 0111.964-3.07M12 6.375a3.375 3.375 0 11-6.75 0 3.375 3.375 0 016.75 0zm8.25 2.25a2.625 2.625 0 11-5.25 0 2.625 2.625 0 015.25 0z"/>
          </svg>
        </div>
        <div>
          <p class="text-sm font-medium" style="color:#0B1A2E;">All Clients</p>
          <p class="text-xs text-gray-400">Browse & manage</p>
        </div>
      </a>

      <a href={~p"/admin/loans"} class="quick-action">
        <div style="width:32px;height:32px;background:#F3F4F6;border-radius:8px;display:flex;align-items:center;justify-content:center;flex-shrink:0;">
          <svg style="width:14px;height:14px;stroke:#6B7280;fill:none;" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 12h3.75M9 15h3.75M9 18h3.75m3 .75H18a2.25 2.25 0 002.25-2.25V6.108c0-1.135-.845-2.098-1.976-2.192a48.424 48.424 0 00-1.123-.08m-5.801 0c-.065.21-.1.433-.1.664 0 .414.336.75.75.75h4.5a.75.75 0 00.75-.75 2.25 2.25 0 00-.1-.664m-5.8 0A2.251 2.251 0 0113.5 2.25H15c1.012 0 1.867.668 2.15 1.586m-5.8 0c-.376.023-.75.05-1.124.08C9.095 4.01 8.25 4.973 8.25 6.108V19.5a2.25 2.25 0 002.25 2.25h.75"/>
          </svg>
        </div>
        <div>
          <p class="text-sm font-medium" style="color:#0B1A2E;">All Loans</p>
          <p class="text-xs text-gray-400">Review & process</p>
        </div>
      </a>
    </div>
  </div>

</div>
