<%# Full-page wrapper — all styling inline, zero dependency on compiled CSS %>
<div style="min-height:100vh; background:#0B1A2E; display:flex; align-items:center; justify-content:center; padding:24px; font-family:'Inter',system-ui,-apple-system,sans-serif; position:relative; overflow:hidden; box-sizing:border-box;">

  <%# Decorative background circles %>
  <div style="position:absolute; top:-140px; right:-140px; width:360px; height:360px; border-radius:50%; background:#0F2040; opacity:0.7; pointer-events:none;"></div>
  <div style="position:absolute; bottom:-160px; left:-160px; width:400px; height:400px; border-radius:50%; background:#0F2040; opacity:0.5; pointer-events:none;"></div>
  <div style="position:absolute; top:40%; left:10%; width:200px; height:200px; border-radius:50%; background:#162B55; opacity:0.3; pointer-events:none;"></div>

  <%# Centered content column %>
  <div style="position:relative; width:100%; max-width:420px;">

    <%# Logo + Branding %>
    <div style="text-align:center; margin-bottom:32px;">
      <div style="display:inline-flex; align-items:center; justify-content:center; width:68px; height:68px; background:#C8970A; border-radius:16px; margin-bottom:18px; box-shadow:0 8px 28px rgba(200,151,10,0.35);">
        <svg style="width:34px; height:34px; color:#0B1A2E; fill:#0B1A2E;" viewBox="0 0 24 24">
          <path d="M11.47 3.84a.75.75 0 011.06 0l8.69 8.69a.75.75 0 101.06-1.06l-8.689-8.69a2.25 2.25 0 00-3.182 0l-8.69 8.69a.75.75 0 001.061 1.06l8.69-8.69z"/>
          <path d="M12 5.432l8.159 8.159c.03.03.06.058.091.086v6.198c0 1.035-.84 1.875-1.875 1.875H15a.75.75 0 01-.75-.75v-4.5a.75.75 0 00-.75-.75h-3a.75.75 0 00-.75.75V21a.75.75 0 01-.75.75H5.625a1.875 1.875 0 01-1.875-1.875v-6.198a2.29 2.29 0 00.091-.086L12 5.432z"/>
        </svg>
      </div>
      <h1 style="color:#FFFFFF; font-size:22px; font-weight:700; margin:0; letter-spacing:-0.3px; line-height:1.2;">Loan Management System</h1>
      <p style="color:#7F93B0; font-size:13px; margin:8px 0 0 0;">Secure access to your account</p>
    </div>

    <%# Login card %>
    <div style="background:#FFFFFF; border-radius:16px; overflow:hidden; box-shadow:0 24px 64px rgba(0,0,0,0.55);">

      <%# Gold accent stripe at top %>
      <div style="height:4px; background:linear-gradient(90deg, #8A6520 0%, #C8970A 50%, #D4B040 100%);"></div>

      <%# Card body %>
      <div style="padding:36px;">
        <h2 style="color:#0B1A2E; font-size:17px; font-weight:600; margin:0 0 28px 0; letter-spacing:-0.2px;">Sign in to continue</h2>

        <%# Error flash %>
        <%= if msg = get(@flash, :error) do %>
          <div style="display:flex; align-items:center; gap:10px; background:#FEF2F2; border:1px solid #FECACA; border-radius:8px; padding:12px 14px; margin-bottom:20px;">
            <svg style="width:16px; height:16px; fill:#DC2626; flex-shrink:0;" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.28 7.22a.75.75 0 00-1.06 1.06L8.94 10l-1.72 1.72a.75.75 0 101.06 1.06L10 11.06l1.72 1.72a.75.75 0 101.06-1.06L11.06 10l1.72-1.72a.75.75 0 00-1.06-1.06L10 8.94 8.28 7.22z" clip-rule="evenodd"/>
            </svg>
            <span style="color:#991B1B; font-size:13px;"><%= msg %></span>
          </div>
        <% end %>

        <%# Info flash %>
        <%= if msg = get(@flash, :info) do %>
          <div style="display:flex; align-items:center; gap:10px; background:#F0FDF4; border:1px solid #BBF7D0; border-radius:8px; padding:12px 14px; margin-bottom:20px;">
            <svg style="width:16px; height:16px; fill:#16A34A; flex-shrink:0;" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.857-9.809a.75.75 0 00-1.214-.882l-3.483 4.79-1.88-1.88a.75.75 0 10-1.06 1.061l2.5 2.5a.75.75 0 001.137-.089l4-5.5z" clip-rule="evenodd"/>
            </svg>
            <span style="color:#166534; font-size:13px;"><%= msg %></span>
          </div>
        <% end %>

        <.form :let={f} for={%{}} action={~p"/login"} as={:session} style="margin:0;">

          <%# Email field %>
          <div style="margin-bottom:20px;">
            <label style="display:block; font-size:13px; font-weight:500; color:#374151; margin-bottom:6px;">
              Email Address
            </label>
            <%= email_input f, :email,
                  required: true,
                  placeholder: "you@example.com",
                  style: "display:block; width:100%; padding:11px 14px; border:1.5px solid #D1D5DB; border-radius:8px; font-size:14px; color:#111827; background:#FFFFFF; box-sizing:border-box; outline:none; font-family:inherit;" %>
          </div>

          <%# Password field %>
          <div style="margin-bottom:28px;">
            <label style="display:block; font-size:13px; font-weight:500; color:#374151; margin-bottom:6px;">
              Password
            </label>
            <%= password_input f, :password,
                  required: true,
                  placeholder: "••••••••",
                  style: "display:block; width:100%; padding:11px 14px; border:1.5px solid #D1D5DB; border-radius:8px; font-size:14px; color:#111827; background:#FFFFFF; box-sizing:border-box; outline:none; font-family:inherit;" %>
          </div>

          <%# Submit button %>
          <%= submit "Sign In →",
                style: "display:block; width:100%; padding:13px 20px; background:#C8970A; color:#0B1A2E; border:none; border-radius:8px; font-size:14px; font-weight:700; cursor:pointer; letter-spacing:0.3px; font-family:inherit; box-sizing:border-box;" %>

        </.form>
      </div>

      <%# Card footer %>
      <div style="background:#F8FAFC; border-top:1px solid #F1F5F9; padding:14px 36px; display:flex; align-items:center; gap:8px;">
        <svg style="width:14px; height:14px; fill:#94A3B8; flex-shrink:0;" viewBox="0 0 20 20">
          <path fill-rule="evenodd" d="M10 1a4.5 4.5 0 00-4.5 4.5V9H5a2 2 0 00-2 2v6a2 2 0 002 2h10a2 2 0 002-2v-6a2 2 0 00-2-2h-.5V5.5A4.5 4.5 0 0010 1zm3 8V5.5a3 3 0 10-6 0V9h6z" clip-rule="evenodd"/>
        </svg>
        <span style="color:#94A3B8; font-size:12px;">256-bit encrypted connection</span>
      </div>
    </div>

    <%# Page footer %>
    <p style="text-align:center; color:#3D5270; font-size:12px; margin-top:24px;">
      &copy; <%= Date.utc_today().year %> Loan Management System. All rights reserved.
    </p>
  </div>
</div>
