<div class="min-h-screen flex items-center justify-center bg-navy-900 px-4 py-12">

  <%# Background pattern %>
  <div class="absolute inset-0 overflow-hidden pointer-events-none">
    <div class="absolute -top-40 -right-40 h-80 w-80 rounded-full bg-navy-800 opacity-60"></div>
    <div class="absolute -bottom-40 -left-40 h-96 w-96 rounded-full bg-navy-800 opacity-40"></div>
    <div class="absolute top-1/3 left-1/4 h-48 w-48 rounded-full bg-navy-700 opacity-20"></div>
  </div>

  <div class="relative w-full max-w-md">

    <%# Logo + Title %>
    <div class="text-center mb-8">
      <div class="inline-flex items-center justify-center h-16 w-16 rounded-2xl bg-gold-500 shadow-lg shadow-gold-500/30 mb-5">
        <svg class="h-8 w-8 text-navy-900" fill="currentColor" viewBox="0 0 24 24">
          <path d="M11.47 3.84a.75.75 0 011.06 0l8.69 8.69a.75.75 0 101.06-1.06l-8.689-8.69a2.25 2.25 0 00-3.182 0l-8.69 8.69a.75.75 0 001.061 1.06l8.69-8.69z"/>
          <path d="M12 5.432l8.159 8.159c.03.03.06.058.091.086v6.198c0 1.035-.84 1.875-1.875 1.875H15a.75.75 0 01-.75-.75v-4.5a.75.75 0 00-.75-.75h-3a.75.75 0 00-.75.75V21a.75.75 0 01-.75.75H5.625a1.875 1.875 0 01-1.875-1.875v-6.198a2.29 2.29 0 00.091-.086L12 5.432z"/>
        </svg>
      </div>
      <h1 class="text-2xl font-bold text-white tracking-tight">Loan Management System</h1>
      <p class="mt-2 text-sm text-gray-400">Secure access to your account</p>
    </div>

    <%# Login card %>
    <div class="bg-white rounded-2xl shadow-2xl shadow-black/40 overflow-hidden">

      <%# Card header stripe %>
      <div class="h-1 bg-gradient-to-r from-gold-600 via-gold-500 to-gold-400"></div>

      <div class="px-8 py-8">
        <h2 class="text-lg font-semibold text-navy-900 mb-6">Sign in to continue</h2>

        <%# Flash messages %>
        <%= if msg = get(@flash, :error) do %>
          <div class="mb-5 flex items-center gap-2.5 rounded-lg border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700">
            <svg class="h-4 w-4 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.28 7.22a.75.75 0 00-1.06 1.06L8.94 10l-1.72 1.72a.75.75 0 101.06 1.06L10 11.06l1.72 1.72a.75.75 0 101.06-1.06L11.06 10l1.72-1.72a.75.75 0 00-1.06-1.06L10 8.94 8.28 7.22z" clip-rule="evenodd"/>
            </svg>
            <%= msg %>
          </div>
        <% end %>

        <%= if msg = get(@flash, :info) do %>
          <div class="mb-5 flex items-center gap-2.5 rounded-lg border border-emerald-200 bg-emerald-50 px-4 py-3 text-sm text-emerald-700">
            <svg class="h-4 w-4 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.857-9.809a.75.75 0 00-1.214-.882l-3.483 4.79-1.88-1.88a.75.75 0 10-1.06 1.061l2.5 2.5a.75.75 0 001.137-.089l4-5.5z" clip-rule="evenodd"/>
            </svg>
            <%= msg %>
          </div>
        <% end %>

        <.form :let={f} for={%{}} action={~p"/login"} as={:session} class="space-y-5">

          <div>
            <label class="form-label">Email Address</label>
            <%= email_input f, :email,
                  required: true,
                  placeholder: "you@example.com",
                  class: "block w-full rounded-lg border-gray-300 px-3.5 py-2.5 text-sm text-gray-900 shadow-sm placeholder-gray-400 focus:border-navy-600 focus:ring-navy-600 transition" %>
          </div>

          <div>
            <label class="form-label">Password</label>
            <%= password_input f, :password,
                  required: true,
                  placeholder: "••••••••",
                  class: "block w-full rounded-lg border-gray-300 px-3.5 py-2.5 text-sm text-gray-900 shadow-sm placeholder-gray-400 focus:border-navy-600 focus:ring-navy-600 transition" %>
          </div>

          <div class="pt-1">
            <%= submit "Sign In →",
                  class: "w-full rounded-lg bg-navy-900 px-4 py-3 text-sm font-semibold text-white
                          shadow-sm hover:bg-navy-800 focus:outline-none focus:ring-2 focus:ring-gold-500
                          focus:ring-offset-2 transition-colors cursor-pointer" %>
          </div>

        </.form>
      </div>
    </div>

    <p class="mt-6 text-center text-xs text-gray-500">
      &copy; <%= Date.utc_today().year %> Loan Management System. All rights reserved.
    </p>
  </div>
</div>
