<%# 2FA settings page — renders inside the normal app layout %>
<div class="mb-6">
  <h1 class="text-2xl font-bold text-navy-900">Security — Two-Factor Authentication</h1>
  <p class="mt-0.5 text-sm text-gray-500">Protect your account with an authenticator app.</p>
</div>

<div class="max-w-2xl space-y-6">

  <%# Current status card %>
  <div class="card p-6">
    <div class="flex items-center justify-between">
      <div>
        <h2 class="section-title">Current Status</h2>
        <p class="text-sm text-gray-500 mt-1"><%= @user.email %></p>
      </div>
      <%= if @user.totp_enabled do %>
        <span class="text-sm font-semibold px-3 py-1 rounded-full bg-green-50 text-green-700 border border-green-200">
          2FA Enabled
        </span>
      <% else %>
        <span class="text-sm font-semibold px-3 py-1 rounded-full bg-gray-100 text-gray-500 border border-gray-200">
          2FA Disabled
        </span>
      <% end %>
    </div>

    <%= if @user.totp_enabled do %>
      <div class="mt-4 pt-4 border-t border-gray-100">
        <p class="text-sm text-gray-600 mb-3">Two-factor authentication is active. You will be asked for a code every time you log in.</p>
        <%= link "Disable 2FA",
              to: ~p"/admin/settings/2fa/disable",
              method: :delete,
              data: [confirm: "Disable two-factor authentication? Your account will be less secure."],
              class: "btn-danger text-sm" %>
      </div>
    <% end %>
  </div>

  <%= if not @user.totp_enabled do %>
    <%# Setup card — shown only when 2FA is not yet enabled %>
    <div class="card p-6">
      <h2 class="section-title mb-1">Enable Two-Factor Authentication</h2>
      <p class="text-sm text-gray-500 mb-6">Scan the QR code below with Google Authenticator, Authy, or any TOTP-compatible app.</p>

      <div class="flex flex-col sm:flex-row gap-8 items-start">

        <%# QR code %>
        <div class="flex-shrink-0">
          <div class="rounded-xl border-2 border-gray-100 p-3 bg-white inline-block">
            <%= Phoenix.HTML.raw(@qr_svg) %>
          </div>
        </div>

        <%# Instructions + manual key + confirm form %>
        <div class="flex-1 min-w-0">
          <ol class="space-y-3 text-sm text-gray-600 mb-5">
            <li class="flex gap-2">
              <span class="flex-shrink-0 w-5 h-5 rounded-full bg-navy-100 text-navy-700 text-xs font-bold flex items-center justify-center">1</span>
              Open your authenticator app and tap <strong>Add account</strong>.
            </li>
            <li class="flex gap-2">
              <span class="flex-shrink-0 w-5 h-5 rounded-full bg-navy-100 text-navy-700 text-xs font-bold flex items-center justify-center">2</span>
              Scan the QR code, or enter the key below manually.
            </li>
            <li class="flex gap-2">
              <span class="flex-shrink-0 w-5 h-5 rounded-full bg-navy-100 text-navy-700 text-xs font-bold flex items-center justify-center">3</span>
              Enter the 6-digit code shown in the app to confirm.
            </li>
          </ol>

          <%# Manual key %>
          <div class="mb-5">
            <p class="text-xs font-medium text-gray-500 mb-1">Manual entry key</p>
            <code class="block bg-gray-50 border border-gray-200 rounded-lg px-4 py-2 text-sm font-mono tracking-widest text-navy-900 break-all">
              <%= @manual_key %>
            </code>
          </div>

          <%# Confirm form %>
          <.form :let={f} for={%{}} action={~p"/admin/settings/2fa/enable"} as={:totp}>
            <label class="form-label">Confirm with your 6-digit code</label>
            <%= text_input f, :code,
                  required: true,
                  maxlength: "6",
                  placeholder: "000000",
                  autocomplete: "one-time-code",
                  inputmode: "numeric",
                  class: "block w-48 rounded-lg border-gray-300 text-center text-xl font-semibold tracking-widest shadow-sm focus:border-navy-600 focus:ring-navy-600 mb-3" %>
            <%= submit "Enable 2FA", class: "btn-primary" %>
          </.form>
        </div>
      </div>
    </div>
  <% end %>

  <%# Info box %>
  <div class="rounded-xl border border-blue-100 bg-blue-50 p-4 text-sm text-blue-700">
    <strong>Why use 2FA?</strong> Even if your password is stolen, an attacker cannot log in without also having your phone. This stops credential stuffing, phishing, and password breach attacks.
  </div>

</div>
