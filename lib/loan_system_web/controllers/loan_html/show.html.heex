<%# Breadcrumb + header %>
<div class="mb-6 flex flex-col sm:flex-row sm:items-start sm:justify-between gap-3">
  <div>
    <div class="flex items-center gap-2 text-sm text-gray-400 mb-1">
      <%= link "Loans", to: ~p"/admin/loans", class: "hover:text-navy-600" %>
      <span>›</span>
      <span class="text-navy-900 font-medium"><%= @loan.client.name %></span>
    </div>
    <h1 class="text-2xl font-bold text-navy-900">Loan Details</h1>
    <p class="text-xs text-gray-400 mt-0.5 font-mono">
      #<%= String.slice(to_string(@loan.id), 0, 8) %>
    </p>
  </div>
  <div class="flex flex-wrap gap-2">
    <%= if @loan.status == "pending" do %>
      <%= link "Edit", to: ~p"/admin/loans/#{@loan}/edit", class: "btn-outline" %>
      <%= link "Approve",
            to: ~p"/admin/loans/#{@loan}/approve",
            method: :patch,
            data: [confirm: "Approve this loan?"],
            class: "btn-gold" %>
      <%= link "Reject",
            to: ~p"/admin/loans/#{@loan}/reject",
            method: :patch,
            data: [confirm: "Reject this loan?"],
            class: "btn-danger" %>
    <% end %>
    <%= link "All Loans", to: ~p"/admin/loans", class: "text-sm font-medium text-gray-400 hover:text-navy-600 self-center" %>
  </div>
</div>

<%# Summary cards %>
<div class="grid grid-cols-2 sm:grid-cols-3 gap-4 mb-6">
  <div class="card p-5">
    <p class="text-xs text-gray-400 uppercase tracking-wide font-medium">Principal</p>
    <p class="mt-1 text-xl font-bold text-navy-900">ZMW <%= @loan.amount %></p>
  </div>
  <div class="card p-5">
    <p class="text-xs text-gray-400 uppercase tracking-wide font-medium">Remaining</p>
    <p class="mt-1 text-xl font-bold text-red-600">ZMW <%= @loan.remaining_balance %></p>
  </div>
  <div class="card p-5 col-span-2 sm:col-span-1">
    <p class="text-xs text-gray-400 uppercase tracking-wide font-medium">Status</p>
    <div class="mt-2">
      <span class={"badge badge-#{@loan.status} text-sm px-3 py-1"}><%= String.capitalize(@loan.status) %></span>
    </div>
  </div>
</div>

<%# Loan details + compound interest %>
<div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mb-6">

  <%# Loan details %>
  <div class="card p-6">
    <h2 class="section-title mb-4">Loan Information</h2>
    <dl class="space-y-3">
      <div class="flex justify-between text-sm">
        <dt class="text-gray-500">Client</dt>
        <dd class="font-medium text-navy-900"><%= @loan.client.name %></dd>
      </div>
      <div class="flex justify-between text-sm">
        <dt class="text-gray-500">Annual Rate</dt>
        <dd class="font-medium text-navy-900"><%= @loan.interest_rate %>%</dd>
      </div>
      <div class="flex justify-between text-sm">
        <dt class="text-gray-500">Term</dt>
        <dd class="font-medium text-navy-900"><%= @loan.term_months %> months</dd>
      </div>
      <%= if @loan.next_payment_date do %>
        <div class="flex justify-between text-sm">
          <dt class="text-gray-500">Next Payment</dt>
          <dd class="font-medium text-navy-900"><%= @loan.next_payment_date %></dd>
        </div>
      <% end %>
      <%= if @loan.approved_at do %>
        <div class="flex justify-between text-sm">
          <dt class="text-gray-500">Approved</dt>
          <dd class="font-medium text-navy-900"><%= Calendar.strftime(@loan.approved_at, "%d %b %Y") %></dd>
        </div>
      <% end %>
      <%= if @loan.purpose do %>
        <div class="pt-2 border-t border-gray-100 text-sm">
          <dt class="text-gray-500 mb-1">Purpose</dt>
          <dd class="text-navy-900"><%= @loan.purpose %></dd>
        </div>
      <% end %>
    </dl>
  </div>

  <%# Compound interest breakdown %>
  <div class="rounded-xl border-2 border-gold-200 bg-gold-50 p-6">
    <h2 class="section-title text-navy-900 mb-1">Interest Breakdown</h2>
    <p class="text-xs text-gray-500 mb-4">Monthly compounding</p>
    <dl class="space-y-3">
      <div class="flex justify-between items-center">
        <dt class="text-sm text-gray-600">Monthly Payment</dt>
        <dd class="text-base font-bold text-navy-900">ZMW <%= @interest.monthly_payment %></dd>
      </div>
      <div class="flex justify-between items-center">
        <dt class="text-sm text-gray-600">Total Repayment</dt>
        <dd class="text-base font-bold text-navy-900">ZMW <%= @interest.total_repayment %></dd>
      </div>
      <div class="flex justify-between items-center border-t border-gold-200 pt-3">
        <dt class="text-sm text-gray-600">Total Interest</dt>
        <dd class="text-base font-bold text-gold-700">ZMW <%= @interest.total_interest %></dd>
      </div>
      <div class="flex justify-between items-center">
        <dt class="text-sm text-gray-600">Effective Annual Rate</dt>
        <dd class="text-base font-bold text-navy-900"><%= @interest.effective_annual_rate %>%</dd>
      </div>
    </dl>
    <p class="mt-4 text-xs text-gray-500 bg-white/60 rounded-lg px-3 py-2">
      Lump-sum if no payments made: <strong>ZMW <%= @interest.compound_lump_sum %></strong>
    </p>
  </div>

</div>

<%# Record payment — only for approved loans with balance %>
<%= if @loan.status == "approved" and Decimal.compare(@loan.remaining_balance, Decimal.new("0")) == :gt do %>
  <div class="card p-6 mb-6">
    <h2 class="section-title mb-4">Record Payment</h2>
    <.form :let={f} for={@payment_changeset} action={~p"/admin/loans/#{@loan}/payments"}
           class="grid grid-cols-1 sm:grid-cols-3 gap-4 items-end">
      <div>
        <label class="form-label">Amount (ZMW)</label>
        <p class="form-hint -mt-1 mb-1">Max: ZMW <%= @loan.remaining_balance %></p>
        <%= number_input f, :amount, step: "0.01", min: "0.01", placeholder: "0.00",
              class: "block w-full rounded-lg border-gray-300 text-sm shadow-sm focus:border-navy-600 focus:ring-navy-600" %>
        <%= error_tag f, :amount %>
      </div>
      <div>
        <label class="form-label">Payment Date</label>
        <%= date_input f, :payment_date,
              class: "block w-full rounded-lg border-gray-300 text-sm shadow-sm focus:border-navy-600 focus:ring-navy-600" %>
        <%= error_tag f, :payment_date %>
      </div>
      <div>
        <%= submit "Record Payment", class: "btn-primary w-full" %>
      </div>
    </.form>
  </div>
<% end %>

<%# Payment history %>
<div class="card overflow-hidden">
  <div class="px-5 py-4 border-b border-gray-100">
    <h2 class="section-title">
      Payment History
      <span class="ml-1.5 text-sm font-normal text-gray-400">(<%= length(@loan.payments) %>)</span>
    </h2>
  </div>
  <%= if Enum.empty?(@loan.payments) do %>
    <div class="py-10 text-center text-sm text-gray-400">No payments recorded yet.</div>
  <% else %>
    <table class="min-w-full">
      <thead>
        <tr class="bg-gray-50 border-b border-gray-100">
          <th class="th">Date</th>
          <th class="th">Amount</th>
          <th class="th">Status</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-50">
        <%= for payment <- @loan.payments do %>
          <tr class="hover:bg-gray-50">
            <td class="td"><%= payment.payment_date %></td>
            <td class="td font-medium">ZMW <%= payment.amount %></td>
            <td class="td">
              <span class={"badge badge-#{payment.status}"}><%= String.capitalize(payment.status) %></span>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% end %>
</div>
