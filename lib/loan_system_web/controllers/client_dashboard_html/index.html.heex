<%# Page header %>
<div class="mb-6">
  <h1 class="text-2xl font-bold text-navy-900">My Dashboard</h1>
  <p class="mt-0.5 text-sm text-gray-500">Your loan account overview</p>
</div>

<%= if is_nil(@client) do %>
  <div class="card p-8 text-center">
    <p class="text-gray-500">No client profile found linked to your account. Please contact an administrator.</p>
  </div>
<% else %>

  <%# Stat cards %>
  <div class="grid grid-cols-1 gap-4 sm:grid-cols-3 mb-8">

    <div class="card p-5">
      <p class="text-sm font-medium text-gray-500">Total Loans</p>
      <p class="stat-value"><%= @client.total_loans %></p>
      <p class="mt-1 text-xs text-gray-400">All time</p>
    </div>

    <div class="card p-5">
      <p class="text-sm font-medium text-gray-500">Outstanding Balance</p>
      <p class="stat-value text-2xl text-red-600">ZMW <%= @client.current_balance %></p>
      <p class="mt-1 text-xs text-gray-400">Across active loans</p>
    </div>

    <div class="card p-5">
      <p class="text-sm font-medium text-gray-500">Next Payment Due</p>
      <%= if @next_payment_date do %>
        <p class="stat-value text-xl"><%= @next_payment_date %></p>
        <%= if @next_payment_amount do %>
          <p class="mt-1 text-xs text-gray-400">ZMW <%= @next_payment_amount %></p>
        <% else %>
          <p class="mt-1 text-xs text-gray-400">Check with your branch</p>
        <% end %>
      <% else %>
        <p class="stat-value text-xl text-gray-400">—</p>
        <p class="mt-1 text-xs text-gray-400">No upcoming payments</p>
      <% end %>
    </div>

  </div>

  <%# Loans table %>
  <div class="card">
    <div class="flex items-center justify-between px-5 py-4 border-b border-gray-100">
      <h2 class="section-title">My Loans</h2>
      <%= link "View all →", to: ~p"/client/loans", class: "text-sm font-medium text-navy-600 hover:text-navy-900" %>
    </div>

    <%= if Enum.empty?(@loans) do %>
      <div class="py-12 text-center">
        <svg class="mx-auto h-10 w-10 text-gray-300" fill="none" stroke="currentColor" stroke-width="1" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 18.75a60.07 60.07 0 0115.797 2.101c.727.198 1.453-.342 1.453-1.096V18.75M3.75 4.5v.75A.75.75 0 013 6h-.75m0 0v-.375c0-.621.504-1.125 1.125-1.125H20.25M2.25 6v9m18-10.5v.75c0 .414.336.75.75.75h.75m-1.5-1.5h.375c.621 0 1.125.504 1.125 1.125v9.75c0 .621-.504 1.125-1.125 1.125h-.375m1.5-1.5H21a.75.75 0 00-.75.75v.75m0 0H3.75m0 0h-.375a1.125 1.125 0 01-1.125-1.125V15m1.5 1.5v-.75A.75.75 0 003 15h-.75"/>
        </svg>
        <p class="mt-3 text-sm text-gray-500">You have no loans yet.</p>
        <p class="text-xs text-gray-400">Contact your branch to apply.</p>
      </div>
    <% else %>
      <div class="overflow-x-auto">
        <table class="min-w-full">
          <thead>
            <tr class="bg-gray-50 border-b border-gray-100">
              <th class="th">Amount</th>
              <th class="th">Balance</th>
              <th class="th">Status</th>
              <th class="th hidden sm:table-cell">Date</th>
              <th class="th"></th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-50">
            <%= for loan <- Enum.take(@loans, 5) do %>
              <tr class="hover:bg-gray-50 transition-colors">
                <td class="td font-medium text-navy-900">ZMW <%= loan.amount %></td>
                <td class="td">ZMW <%= loan.remaining_balance %></td>
                <td class="td">
                  <span class={"badge badge-#{loan.status}"}><%= String.capitalize(loan.status) %></span>
                </td>
                <td class="td text-gray-400 hidden sm:table-cell">
                  <%= Calendar.strftime(loan.inserted_at, "%d %b %Y") %>
                </td>
                <td class="td text-right">
                  <%= link "View", to: ~p"/client/loans/#{loan}", class: "text-sm font-medium text-navy-600 hover:text-navy-900" %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% end %>
  </div>

<% end %>
